            {
              "id": "inspect",
              "title": "检查",
              "kind": "invoke",
              "function": "tree.inspect",
              "requiresSelection": true,
              "icon": {
                "host": "search"
              }
            },
            {
              "id": "reset",
              "title": "重置",
              "kind": "invoke",
              "function": "tree.reset",
              "requiresSelection": false,
              "icon": {
                "host": "reset"
              }
            },
            {
              "id": "rename",
              "title": "修改标签",
              "kind": "invoke",
              "function": "tree.rename",
              "requiresSelection": true
            },
            {
              "id": "add",
              "title": "添加节点",
              "kind": "invoke",
              "function": "tree.add",
              "requiresSelection": false
            },
            {
              "id": "remove",
