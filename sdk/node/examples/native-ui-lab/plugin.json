{
  "schemaVersion": 2,
  "id": "org.example.native-ui-lab",
  "displayName": "UI 验收实验室",
  "version": "0.3.4",
  "pluginAPIVersion": 3,
  "requires": {
    "buildProviders": 1,
    "buildSystems": 1,
    "serverProcess": 1,
    "ui": 3
  },
  "vendor": {
    "id": "org.example",
    "displayName": "Example",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": [
    "languageServer.launch",
    "process.build",
    "ui.contribute"
  ],
  "activationEvents": [
    "onBuildSystem:native-ui-lab",
    "onView:org.example.native-ui-lab.tree",
    "onView:org.example.native-ui-lab.list",
    "onView:org.example.native-ui-lab.static-tree",
    "onView:org.example.native-ui-lab.static-list",
    "onView:org.example.native-ui-lab.empty",
    "onView:org.example.native-ui-lab.form",
    "onView:org.example.native-ui-lab.buttons"
  ],
  "languages": [],
  "buildSystems": [
    {
      "id": "native-ui-lab",
      "displayName": "UI Lab Provider",
      "detection": {
        "markers": [
          "lithe-ui-lab.json"
        ],
        "nesting": "outermost"
      },
      "invocation": {
        "executables": [
          {
            "kind": "command",
            "command": "node"
          }
        ]
      },
      "provider": {
        "launch": {
          "kind": "runtime",
          "tool": "node",
          "minimumVersion": "20.3",
          "entry": "backend/main.mjs"
        },
        "arguments": [],
        "executesProjectCode": false,
        "mayUseNetwork": false
      },
      "model": {
        "source": "provider"
      },
      "tasks": [],
      "dependencies": {
        "source": "provider",
        "scopes": [
          "workspace",
          "project"
        ]
      },
      "sync": {
        "watch": [
          "lithe-ui-lab.json"
        ]
      }
    }
  ],
  "ui": {
    "toolWindows": [
      {
        "id": "org.example.native-ui-lab.tree",
