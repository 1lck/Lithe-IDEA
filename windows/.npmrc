registry=https://registry.npmmirror.com/
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
shamefully-hoist=false
strict-peer-dependencies=false
# Allow Electron and esbuild to run their postinstall scripts.
# pnpm 10+ blocks postinstall by default; without these the electron
# binary is never downloaded and `pnpm dev` fails with "Electron uninstall".
only-built-dependencies[]=electron
only-built-dependencies[]=esbuild
