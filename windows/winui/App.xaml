<Application
    x:Class="Lithe.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LitheWorkspaceBrush" Color="#F5F6F7" />
                    <SolidColorBrush x:Key="LithePanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LitheGutterBrush" Color="#F8F9FA" />
                    <SolidColorBrush x:Key="LitheSubtleBrush" Color="#EEF1F3" />
                    <SolidColorBrush x:Key="LitheBorderBrush" Color="#D8DDE2" />
                    <SolidColorBrush x:Key="LitheTextBrush" Color="#1C2024" />
                    <SolidColorBrush x:Key="LitheMutedTextBrush" Color="#66717D" />
                    <SolidColorBrush x:Key="LitheAccentBrush" Color="#2E7181" />
                    <SolidColorBrush x:Key="LitheAccentSubtleBrush" Color="#DDEEF1" />
                    <SolidColorBrush x:Key="LitheAddedBrush" Color="#DDF3E4" />
                    <SolidColorBrush x:Key="LitheRemovedBrush" Color="#F8E0E0" />
                    <SolidColorBrush x:Key="LitheChangedBrush" Color="#F8F0CF" />
                    <SolidColorBrush x:Key="LitheWarningBrush" Color="#FFF4CE" />
                    <!-- Shared UI parity tokens. Keep these values in one place so
                         WinUI surfaces can follow the macOS LitheTheme metrics. -->
                    <SolidColorBrush x:Key="LitheWindowBrush" Color="#F5F6F7" />
                    <SolidColorBrush x:Key="LitheTitlebarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LitheToolHeaderBrush" Color="#EEF1F3" />
                    <SolidColorBrush x:Key="LitheSidebarBrush" Color="#F5F6F7" />
                    <SolidColorBrush x:Key="LitheEditorBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LitheRaisedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LitheInputBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LitheProjectOrangeBrush" Color="#E66D47" />
                    <SolidColorBrush x:Key="LitheProjectTealBrush" Color="#1FA1AD" />
                    <SolidColorBrush x:Key="LitheProjectBlueBrush" Color="#4787E0" />
                    <SolidColorBrush x:Key="LitheProjectGreenBrush" Color="#4DA97A" />
                    <SolidColorBrush x:Key="LitheProjectGoldBrush" Color="#B88616" />
                     <SolidColorBrush x:Key="LitheSelectionBrush" Color="#CFE5EA" />
                     <SolidColorBrush x:Key="LitheSubtleSelectionBrush" Color="#E4ECEE" />
                     <SolidColorBrush x:Key="LitheActivityBarBrush" Color="#EEF1F3" />
                     <SolidColorBrush x:Key="LitheToolWindowBrush" Color="#25282B" />
                     <SolidColorBrush x:Key="LitheListItemBrush" Color="Transparent" />
                     <SolidColorBrush x:Key="LitheHoverBrush" Color="#0D000000" />
                    <SolidColorBrush x:Key="LithePressedBrush" Color="#18000000" />
                    <SolidColorBrush x:Key="LitheSuccessBrush" Color="#2E9B55" />
                    <SolidColorBrush x:Key="LitheErrorBrush" Color="#C83F3F" />
                    <SolidColorBrush x:Key="LitheLinkBrush" Color="#3B83B5" />
                    <Color x:Key="LitheCodeTextColor">#1C2024</Color>
                    <Color x:Key="LitheCodeKeywordColor">#005A9C</Color>
                    <Color x:Key="LitheCodeAnnotationColor">#8A4B08</Color>
                    <Color x:Key="LitheCodeTypeColor">#267F5F</Color>
                    <Color x:Key="LitheCodeNumberColor">#7A3E9D</Color>
                    <Color x:Key="LitheCodeStringColor">#A31515</Color>
                    <Color x:Key="LitheCodeCommentColor">#557A46</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LitheWorkspaceBrush" Color="#1B1D20" />
                    <SolidColorBrush x:Key="LithePanelBrush" Color="#2A2D30" />
                    <SolidColorBrush x:Key="LitheGutterBrush" Color="#1F2124" />
                    <SolidColorBrush x:Key="LitheSubtleBrush" Color="#34373D" />
                    <SolidColorBrush x:Key="LitheBorderBrush" Color="#2D3033" />
                    <SolidColorBrush x:Key="LitheTextBrush" Color="#DADADC" />
                    <SolidColorBrush x:Key="LitheMutedTextBrush" Color="#8D8E90" />
                    <SolidColorBrush x:Key="LitheAccentBrush" Color="#4F94FA" />
                    <SolidColorBrush x:Key="LitheAccentSubtleBrush" Color="#2B4A7D" />
                    <SolidColorBrush x:Key="LitheAddedBrush" Color="#213B2A" />
                    <SolidColorBrush x:Key="LitheRemovedBrush" Color="#422A2D" />
                    <SolidColorBrush x:Key="LitheChangedBrush" Color="#403A25" />
                    <SolidColorBrush x:Key="LitheWarningBrush" Color="#594A1F" />
                    <SolidColorBrush x:Key="LitheWindowBrush" Color="#1B1D20" />
                    <SolidColorBrush x:Key="LitheTitlebarBrush" Color="#25282B" />
                    <SolidColorBrush x:Key="LitheToolHeaderBrush" Color="#1F2124" />
                    <SolidColorBrush x:Key="LitheSidebarBrush" Color="#17181B" />
                    <SolidColorBrush x:Key="LitheEditorBrush" Color="#131416" />
                    <SolidColorBrush x:Key="LitheRaisedBrush" Color="#2A2D30" />
                    <SolidColorBrush x:Key="LitheInputBrush" Color="#111214" />
                    <SolidColorBrush x:Key="LitheProjectOrangeBrush" Color="#E66D47" />
                    <SolidColorBrush x:Key="LitheProjectTealBrush" Color="#1FA1AD" />
                    <SolidColorBrush x:Key="LitheProjectBlueBrush" Color="#4787E0" />
                    <SolidColorBrush x:Key="LitheProjectGreenBrush" Color="#4DA97A" />
                    <SolidColorBrush x:Key="LitheProjectGoldBrush" Color="#B88616" />
                     <SolidColorBrush x:Key="LitheSelectionBrush" Color="#2B4A7D" />
                     <SolidColorBrush x:Key="LitheSubtleSelectionBrush" Color="#343940" />
                     <SolidColorBrush x:Key="LitheActivityBarBrush" Color="#17181B" />
                     <SolidColorBrush x:Key="LitheToolWindowBrush" Color="#25282B" />
                     <SolidColorBrush x:Key="LitheListItemBrush" Color="Transparent" />
                     <SolidColorBrush x:Key="LitheHoverBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="LithePressedBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="LitheSuccessBrush" Color="#48B863" />
                    <SolidColorBrush x:Key="LitheErrorBrush" Color="#EB5555" />
                    <SolidColorBrush x:Key="LitheLinkBrush" Color="#6BAEFF" />
                    <Color x:Key="LitheCodeTextColor">#F1F3F5</Color>
                    <Color x:Key="LitheCodeKeywordColor">#75B6E7</Color>
                    <Color x:Key="LitheCodeAnnotationColor">#D7BA7D</Color>
                    <Color x:Key="LitheCodeTypeColor">#73C991</Color>
                    <Color x:Key="LitheCodeNumberColor">#C586C0</Color>
                    <Color x:Key="LitheCodeStringColor">#E8A7A7</Color>
                    <Color x:Key="LitheCodeCommentColor">#8DB47C</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Define shared metrics before styles that consume them. WinUI
                 StaticResource lookup does not support forward references. -->
            <x:Double x:Key="LitheRowHeight">24</x:Double>
            <x:Double x:Key="LitheTabHeight">34</x:Double>
            <GridLength x:Key="LitheToolbarHeight">40</GridLength>
            <GridLength x:Key="LitheToolWindowHeaderHeight">30</GridLength>
            <GridLength x:Key="LitheStatusBarHeight">24</GridLength>
            <x:Double x:Key="LitheCornerRadius">5</x:Double>
            <x:Double x:Key="LitheControlCornerRadius">6</x:Double>
            <GridLength x:Key="LitheActivityBarWidth">48</GridLength>
            <x:Double x:Key="LithePanelGap">6</x:Double>
            <x:Double x:Key="LithePanelCornerRadius">10</x:Double>
            <x:Double x:Key="LitheCommitRowHeight">38</x:Double>
            <x:Double x:Key="LitheSidebarMinWidth">220</x:Double>
            <GridLength x:Key="LitheSidebarPreferredWidth">270</GridLength>

            <Style x:Key="LithePaneHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource LitheMutedTextBrush}" />
                <Setter Property="CharacterSpacing" Value="0" />
            </Style>
            <Style x:Key="LitheIconButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="LitheActivityButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="LithePrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{ThemeResource LitheAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="LitheToolWindowHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource LitheMutedTextBrush}" />
                <Setter Property="CharacterSpacing" Value="120" />
            </Style>
            <Style x:Key="LitheCommitHashStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource LitheAccentBrush}" />
            </Style>
            <Style x:Key="LitheCommitMetaStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource LitheMutedTextBrush}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource LitheListItemBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style TargetType="TreeViewItem">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="TabViewItem">
                <Setter Property="MinHeight" Value="{StaticResource LitheTabHeight}" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <!-- LitheTheme.Metrics equivalents. Use these instead of per-view
                 magic numbers when adding or adjusting WinUI surfaces. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
