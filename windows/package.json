{
  "name": "lithe-windows",
  "version": "0.1.0",
  "description": "Lithe - the IDEA-shaped core for AI-assisted development (Windows port)",
  "main": "./out/main/index.js",
  "author": "Lithe contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "postinstall": "node -e \"console.log('skip native rebuild — node-pty uses N-API prebuilds')\""
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.1",
    "@electron-toolkit/utils": "3.0.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@vscode/ripgrep": "^1.18.0",
    "@vscode/ripgrep-win32-x64": "^1.18.0",
    "chokidar": "3.6.0",
    "electron-updater": "6.3.9",
    "node-pty": "1.2.0-beta.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "1.0.1",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "monaco-editor": "0.52.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
