{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "app.lithe.linux",
  "mainBinaryName": "lithe-linux",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lithe",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "hiddenTitle": true,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Lithe desktop IDE",
    "longDescription": "Lithe is a desktop IDE with Java, Git, terminal, search, and local-history support.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
