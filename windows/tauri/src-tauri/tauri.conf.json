{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lithe",
  "version": "0.3.0",
  "identifier": "app.lithe.windows",
  "build": {
    "beforeDevCommand": "node ../../scripts/build-windows-ide-mcp.mjs && bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node ../../scripts/build-windows-ide-mcp.mjs && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["main-capability"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../src/extensions/bundled/**/*": "extensions/bundled/",
      "helpers/": "helpers/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
