{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@lithe/v0/*": ["../../Plugins/win/Official/V0Support/*"],
      "@lithe/php/*": ["../../Plugins/win/Official/PhpSupport/*"],
      "@tauri-apps/plugin-http": ["./node_modules/@tauri-apps/plugin-http"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "zustand/*": ["./node_modules/zustand/*"],
      "@lithe/editor/*": ["../../frontend/editor/src/*"],
      "monaco-editor": ["./node_modules/monaco-editor"],
      "monaco-editor/*": ["./node_modules/monaco-editor/*"]
    }
  },
  "include": ["src", "../../Plugins/win/Official/V0Support"],
  "exclude": ["**/*.stories.tsx", "**/*.stories.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
