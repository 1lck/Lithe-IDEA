    {
      "name": "complete-dormant-document",
      "command": "toolchains.decodePinDocument",
      "input": {
        "document": "{\"pins\":{\"nested\":{\"dev.example:compiler\":{\"home\":\"/fixture/tool\",\"provider\":\"host:system\",\"version\":\"1.0\"}}},\"toolchains\":{\"legacy\":{\"home\":\"/fixture/legacy\"}},\"version\":1}"
      },
      "expected": {
        "status": "ok",
        "document": {
          "version": 1,
          "toolchains": {
            "legacy": {
              "home": "/fixture/legacy"
            }
          },
          "pins": {
            "nested": {
              "dev.example:compiler": {
                "home": "/fixture/tool",
                "version": "1.0",
                "provider": "host:system"
              }
            }
          }
        }
      }
    },
    {
      "name": "absent-reset-writes-nothing",
      "command": "toolchains.editPinSources",
      "input": {
        "document": null,
        "ignoreDocument": null,
        "directory": ".",
        "edits": [
          {
            "tool": "dev.example:compiler",
            "pin": null
          }
        ]
      },
      "expected": {
        "status": "ok",
        "edit": {
          "document": null,
          "documentChanged": false,
          "ignoreDocument": null,
          "ignoreChanged": false
        }
      }
    },
    {
      "name": "existing-unchanged-preserves-bytes",
      "command": "toolchains.editPinSources",
      "input": {
        "document": "{ \"version\": 1, \"toolchains\": {} }\n",
