{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "storage-plan",
      "command": "toolchains.pinStoragePlan",
      "input": {},
      "expected": {
        "status": "ok",
        "storage": {
          "documentRelativePath": ".lithe/toolchains/local.json",
          "ignoreRelativePath": ".lithe/.gitignore",
          "maximumDocumentBytes": 1048576,
          "maximumIgnoreBytes": 65536
        }
      }
    },
    {
      "name": "storage-plan-refuses-unknown-input",
      "command": "toolchains.pinStoragePlan",
      "input": {
        "unexpected": true
      },
      "error": "plugin.toolchain.invalidParams"
    },
    {
