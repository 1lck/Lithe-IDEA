{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "explicit-value-replaces-inherited",
      "request": {
        "inherited": {
          "JAVA_HOME": "inherited-jdk",
          "PATH": "bin"
        },
        "overrides": {
          "JAVA_HOME": "selected-jdk"
        },
        "caseInsensitive": false
      },
      "expected": {
        "environment": {
          "JAVA_HOME": "selected-jdk",
          "PATH": "bin"
        }
      }
    },
    {
      "name": "no-override-keeps-inherited",
      "request": {
        "inherited": {
          "JAVA_HOME": "inherited-jdk"
        },
        "overrides": {},
        "caseInsensitive": false
      },
      "expected": {
        "environment": {
          "JAVA_HOME": "inherited-jdk"
        }
      }
    },
    {
      "name": "unresolved-binding-contributes-nothing",
      "request": {
        "inherited": {
          "JAVA_HOME": "inherited-jdk"
        },
        "overrides": {
          "JAVA_HOME": {
            "toolchain": "example.toolchain",
            "property": "home"
          },
          "TOOL_HOME": {
            "toolchain": "example.toolchain",
            "property": "home"
          }
        },
        "caseInsensitive": false
      },
      "expected": {
        "environment": {
          "JAVA_HOME": "inherited-jdk"
        }
      }
    },
    {
      "name": "windows-keys-are-one-name",
      "request": {
        "inherited": {
          "JAVA_HOME": "inherited-jdk",
          "Path": "bin"
        },
        "overrides": {
          "java_home": "user-jdk"
        },
        "caseInsensitive": true
      },
      "expected": {
        "environment": {
          "JAVA_HOME": "user-jdk",
          "PATH": "bin"
        }
      }
    }
  ]
}
