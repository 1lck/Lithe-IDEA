    {
      "name": "record-pushes-departure-and-clears-forward",
      "request": {
        "state": {
          "back": [],
          "forward": [
            {
              "document": "file:///w/C.java",
              "line": 1,
              "column": 0
            }
          ]
        },
        "event": {
          "type": "record",
          "departure": {
            "document": "file:///w/A.java",
            "line": 4,
            "column": 2
          },
          "destination": {
            "document": "file:///w/B.java",
            "line": 9,
            "column": 7
          }
        }
      },
      "expected": {
        "state": {
          "back": [
            {
              "document": "file:///w/A.java",
              "line": 4,
              "column": 2
            }
          ],
          "forward": []
        },
        "destination": null
      }
    },
