{
  "description": "Editor tab group membership, selection, split and collapse rules owned by Rust Core (editor.workbenchState.reduce). Orientation horizontal places children side by side; vertical stacks them. Sizes and drag geometry stay in the platform.",
  "cases": [
    {
      "name": "sync removes duplicate members and keeps the first occurrence",
      "state": {
        "layout": {
          "group": "g1"
        },
        "tabs": [
          {
            "id": "a",
            "group": "g1"
          }
        ],
        "selections": [
          {
            "group": "g1",
            "tab": "a"
          }
        ],
        "focusedGroup": "g1"
      },
      "action": {
        "type": "sync",
        "tabs": [
          "a",
          "b",
          "a"
        ]
      },
      "applied": true,
      "expected": {
        "layout": {
          "group": "g1"
        },
        "tabs": [
          {
            "id": "a",
            "group": "g1"
          },
          {
            "id": "b",
            "group": "g1"
          }
        ],
        "selections": [
          {
            "group": "g1",
            "tab": "a"
          }
        ],
        "focusedGroup": "g1"
      }
    },
    {
      "name": "sync places new and orphaned members in the focused group",
      "state": {
        "layout": {
          "split": {
            "id": "s1",
            "orientation": "horizontal",
            "first": {
              "group": "g1"
            },
            "second": {
              "group": "g2"
