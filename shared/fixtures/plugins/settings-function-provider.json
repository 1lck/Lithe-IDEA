{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "stable-same-workspace-selection",
      "request": {
        "pluginID": "dev.example.settings",
        "version": "1.0.0",
        "function": "index.refresh",
        "rootUri": "file:///fixture/project",
        "candidates": [
          {
            "sessionID": "b",
            "version": "1.0.0"
          },
          {
            "sessionID": "a",
            "version": "1.0.0"
          }
        ]
      },
      "facts": [
        {
          "sessionID": "b",
          "pluginID": "dev.example.settings",
          "rootUri": "file:///fixture/project",
          "serves": true
        },
        {
          "sessionID": "a",
          "pluginID": "dev.example.settings",
          "rootUri": "file:///fixture/project/",
          "serves": true
        }
      ],
      "sessionID": "a"
    },
