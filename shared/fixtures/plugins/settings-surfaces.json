      "command": "plugins.settings.catalog",
      "input": {
        "plugins": [
          {
            "manifest": {
              "schemaVersion": 2,
              "id": "dev.lithe.fixture.settings-v2",
              "displayName": "Settings v2 Fixture",
              "version": "0.1.0",
              "pluginAPIVersion": 3,
              "requires": {
                "buildProviders": 1,
                "buildSystems": 1,
                "languageServers": 2,
                "languages": 1,
                "serverProcess": 1,
                "settings": 2
              },
              "vendor": {
                "id": "org.example",
                "displayName": "Example",
                "signatureRequirement": "publisherPackage"
              },
              "permissions": [
                "languageServer.launch",
                "process.build"
              ],
              "activationEvents": [
                "onBuildSystem:mix",
                "onLanguage:elixir"
              ],
              "languages": [
                {
                  "id": "elixir",
                  "displayName": "Elixir",
                  "fileExtensions": [
                    "ex",
                    "exs"
                  ],
                  "projectFileNames": [
                    "mix.exs"
                  ]
                }
              ],
              "languageServers": [
                {
                  "languageID": "elixir",
                  "launch": {
                    "kind": "systemCommand",
                    "commands": [
                      "elixir-ls"
                    ]
                  },
                  "arguments": [
                    "--stdio",
                    "--env=${setting:mixEnv}"
                  ],
                  "workspaceConfiguration": {
                    "elixirLS": {
                      "dialyzerEnabled": "${setting:dialyzer}"
                    }
                  }
                }
              ],
              "buildSystems": [
                {
                  "id": "mix",
                  "displayName": "Mix",
                  "detection": {
                    "markers": [
                      "mix.exs"
                    ],
                    "nesting": "outermost"
                  },
                  "invocation": {
                    "executables": [
                      {
                        "kind": "command",
                        "command": "mix"
                      }
                    ]
                  },
                  "provider": {
                    "languageServer": "elixir",
                    "executesProjectCode": true,
                    "mayUseNetwork": false
                  },
                  "model": {
                    "source": "provider"
                  },
                  "tasks": [
                    {
                      "id": "compile",
                      "displayName": "Compile",
                      "group": "build",
                      "scopes": [
                        "workspace"
                      ],
                      "arguments": [
                        "compile"
                      ]
                    },
                    {
                      "id": "deps-get",
                      "displayName": "Fetch Dependencies",
                      "group": "other",
                      "scopes": [
                        "workspace"
                      ],
                      "arguments": [
                        "deps.get"
                      ]
                    }
                  ],
                  "dependencies": {
                    "source": "provider",
                    "scopes": [
                      "workspace"
                    ]
                  },
                  "sync": {
                    "watch": [
                      "mix.exs",
                      "mix.lock"
                    ]
                  },
                  "layout": {
                    "excluded": [
                      "_build",
                      "deps"
                    ]
                  }
                }
              ],
              "settings": [
                {
                  "id": "dialyzer",
                  "type": "boolean",
                  "title": "Dialyzer",
                  "default": true,
                  "scope": "project",
                  "effect": "immediate",
                  "page": {
                    "languageID": "elixir"
                  }
                },
                {
                  "id": "mixEnv",
                  "type": "text",
                  "title": "MIX_ENV",
                  "default": "dev",
                  "pattern": "[a-z]+",
                  "scope": "project",
                  "effect": "restart",
                  "page": {
                    "languageID": "elixir"
                  },
                  "section": "Server"
                },
                {
                  "id": "checks",
                  "type": "multiSelect",
                  "title": "Checks",
                  "default": [
                    "format"
                  ],
                  "options": [
                    {
                      "value": "format",
                      "title": "Format"
                    },
                    {
                      "value": "credo",
                      "title": "Credo"
                    }
                  ],
                  "effect": "nextRun",
                  "page": {
                    "buildSystemID": "mix"
                  }
                }
              ],
              "settingActions": [
                {
                  "id": "rebuildPlt",
                  "title": "Rebuild PLT",
                  "function": "dialyzer.rebuild",
                  "page": {
                    "languageID": "elixir"
                  },
                  "confirm": true
                }
              ]
            },
            "owner": {
              "pluginID": "dev.lithe.fixture.settings-v2",
              "version": "0.1.0"
            },
            "enabled": true
          }
        ]
      },
      "status": "ok",
      "pages": 2
    },
