{
  "description": "Hidden-path rules shared by Rust Core, macOS and Windows. isDirectory is true for a folder, false for a file and null when the host does not know. hidden means the tree, search and history leave the path out; watchedDespiteHiding marks hidden paths whose file events must still be delivered. Rule lists are the user's own entries; built-ins are added by Core.",
  "defaults": {
    "hiddenDirectoryNames": [
      ".git",
      ".svn",
      ".worktree",
      ".worktrees",
      ".build",
      ".swiftpm",
      "node_modules",
      ".venv",
      "venv",
      "__pycache__",
      "target",
      "build",
      "DerivedData",
      ".gradle",
      ".next",
      "dist",
      "coverage",
      "design-qa-artifacts",
      ".artifacts"
    ],
    "hiddenFilePatterns": [
      ".DS_Store",
      "*.pyc",
      ".lithe/**",
      ".lithe/run/local.json"
    ],
    "builtInPatterns": [
      "**/.git/",
      "**/.svn/",
      "**/.worktree/",
      "**/.worktrees/",
      "**/.build/",
      "**/.swiftpm/",
      "**/node_modules/",
      "**/.venv/",
      "**/venv/",
      "**/__pycache__/",
      "**/target/",
      "**/build/",
      "**/DerivedData/",
      "**/.gradle/",
      "**/.next/",
      "**/dist/",
      "**/coverage/",
      "**/design-qa-artifacts/",
      "**/.artifacts/",
      ".DS_Store",
      "*.pyc",
      ".lithe/**",
      ".lithe/run/local.json"
    ],
    "configurationDirectory": ".lithe",
    "configurationPattern": ".lithe/**"
  },
