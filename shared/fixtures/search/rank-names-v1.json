{
  "version": 1,
  "description": "workspace.rankNames cases. Hosts that list candidates themselves (Windows remote and WSL roots, symbol and navigator lists) send names, the query and explicit context, and receive indices into the request with Core's degree, tier and UTF-16 name ranges. Degrees come from the matcher behind workspace.searchEverywhere; the old Windows fuzzyScore found neither the camel-hump query 'DH' nor ranked it above plain substrings.",
  "cases": [
    {
      "id": "camel-hump-initials-find-the-class-file",
      "request": {
        "query": "DH",
        "candidates": [
          {"name": "PadController.java", "path": "src/PadController.java"},
          {"name": "DeviceHandler.java", "path": "src/DeviceHandler.java"}
        ]
      },
      "expected": [
        {"index": 1, "tier": "other", "ranges": [{"start": 0, "length": 1}, {"start": 6, "length": 1}]}
      ]
    },
    {
      "id": "exact-beats-prefix-beats-substring",
      "request": {
        "query": "DeviceHandler",
        "candidates": [
          {"name": "AbstractDeviceHandlerBase.java", "path": "src/AbstractDeviceHandlerBase.java"},
          {"name": "DeviceHandlerFactory.java", "path": "src/DeviceHandlerFactory.java"},
          {"name": "DeviceHandler.java", "path": "src/DeviceHandler.java"},
          {"name": "PadController.java", "path": "src/PadController.java"}
        ]
      },
      "expected": [
        {"index": 2, "tier": "other", "ranges": [{"start": 0, "length": 13}]},
        {"index": 1, "tier": "other", "ranges": [{"start": 0, "length": 13}]},
        {"index": 0, "tier": "other", "ranges": [{"start": 8, "length": 13}]}
      ]
    },
    {
      "id": "name-match-beats-path-only-match",
      "request": {
        "query": "handler",
        "candidates": [
          {"name": "Pad.java", "path": "handler/Pad.java"},
          {"name": "Handler.java", "path": "Handler.java"}
        ]
      },
      "expected": [
        {"index": 1, "tier": "other", "ranges": [{"start": 0, "length": 7}]},
        {"index": 0, "tier": "other", "ranges": []}
      ]
    },
    {
      "id": "open-then-recent-break-ties-and-limits-apply-per-tier",
      "request": {
        "query": "util",
        "candidates": [
          {"name": "util.ts", "path": "a/util.ts"},
          {"name": "util.ts", "path": "b/util.ts"},
          {"name": "util.ts", "path": "c/util.ts"},
          {"name": "util.ts", "path": "d/util.ts"}
        ],
        "context": {"openPaths": ["d/util.ts"], "recentPaths": ["c/util.ts", "b/util.ts"]},
        "limitPerTier": 1
      },
      "expected": [
        {"index": 3, "tier": "open", "ranges": [{"start": 0, "length": 4}]},
        {"index": 2, "tier": "recent", "ranges": [{"start": 0, "length": 4}]},
        {"index": 0, "tier": "other", "ranges": [{"start": 0, "length": 4}]}
      ]
    },
    {
      "id": "blank-query-matches-nothing",
      "request": {"query": "  ", "candidates": [{"name": "a.ts"}]},
      "expected": []
    }
  ]
}
