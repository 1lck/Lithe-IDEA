{
  "protocolVersion": 1,
  "cases": [
    {
      "name": "followSystem",
      "request": {
        "mode": "system",
        "proxyType": "http",
        "host": "proxy.example",
        "port": 3128,
        "username": "lithe",
        "password": "secret",
        "exclusions": ["127.0.0.1"]
      },
      "expected": {
        "policy": "system",
        "proxyType": "http",
        "host": "",
        "port": 0,
        "username": "",
        "password": "",
        "exclusions": [],
        "configured": false
      }
    },
    {
      "name": "direct",
      "request": {
        "mode": "direct",
        "proxyType": "http",
        "host": "proxy.example",
        "port": 3128
      },
      "expected": {
        "policy": "direct",
        "proxyType": "http",
        "host": "",
        "port": 0,
        "username": "",
        "password": "",
        "exclusions": [],
        "configured": false
      }
    },
    {
      "name": "customHttpWithCredentialsAndExclusions",
      "request": {
        "mode": "custom",
        "proxyType": "http",
        "host": " 127.0.0.1 ",
        "port": 7890,
        "username": " lithe ",
        "password": "s ecret",
        "exclusions": [" 127.0.0.1 ", "", " *.internal.example "]
      },
      "expected": {
        "policy": "custom",
        "proxyType": "http",
        "host": "127.0.0.1",
        "port": 7890,
        "username": "lithe",
        "password": "s ecret",
        "exclusions": ["127.0.0.1", "*.internal.example"],
        "configured": true
      }
    },
    {
      "name": "customSocks5",
      "request": {
        "mode": "custom",
