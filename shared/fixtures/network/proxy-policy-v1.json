        "policy": "direct",
        "proxyType": "http",
        "host": "",
        "port": 0,
        "username": "",
        "password": "",
        "exclusions": [],
        "configured": false
      }
    },
    {
      "name": "customHttpWithCredentialsAndExclusions",
      "request": {
        "mode": "custom",
        "proxyType": "http",
        "host": " 127.0.0.1 ",
        "port": 7890,
        "username": " lithe ",
        "password": "s ecret",
        "exclusions": [
          " 127.0.0.1 ",
          "",
          " *.internal.example "
        ]
      },
      "expected": {
        "policy": "custom",
        "proxyType": "http",
        "host": "127.0.0.1",
        "port": 7890,
        "username": "lithe",
        "password": "s ecret",
        "exclusions": [
          "127.0.0.1",
          "*.internal.example"
        ],
        "configured": true
      }
    },
    {
