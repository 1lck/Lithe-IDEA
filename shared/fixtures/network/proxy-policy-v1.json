{
  "protocolVersion": 1,
  "cases": [
    {
      "name": "followSystem",
      "request": {
        "mode": "system",
        "proxyType": "http",
        "host": "proxy.example",
        "port": 3128,
        "username": "lithe",
        "password": "secret",
        "exclusions": [
          "127.0.0.1"
        ]
      },
      "expected": {
        "policy": "system",
        "proxyType": "http",
        "host": "",
        "port": 0,
        "username": "",
        "password": "",
        "exclusions": [],
        "configured": false
      }
    },
