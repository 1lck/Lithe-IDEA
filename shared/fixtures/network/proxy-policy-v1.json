      },
      "expected": {
        "policy": "custom",
        "proxyType": "socks5",
        "host": "proxy.example",
        "port": 1080,
        "username": "",
        "password": "",
        "exclusions": [],
        "configured": true
      }
    },
    {
      "name": "customWithoutProxyTypeDefaultsToHttp",
      "request": {
        "mode": "custom",
        "host": "proxy.example",
        "port": 3128
      },
      "expected": {
        "policy": "custom",
