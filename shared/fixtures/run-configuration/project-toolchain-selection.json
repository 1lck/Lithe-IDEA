        "mavenExecutablePath": "C:/Example Maven/bin/mvn.cmd",
        "mavenJavaHomePath": "C:/Maven JDK",
        "runtimeExecutablePaths": {}
      }
    },
    "explicit automatic override inherits project defaults": {
      "toolchain": {
        "javaHomePath": "C:/Example JDK",
        "mavenExecutablePath": "C:/Example Maven/bin/mvn.cmd",
        "mavenJavaHomePath": "C:/Maven JDK",
        "runtimeExecutablePaths": {}
      }
    },
    "missing toolchain stays automatic": {
      "toolchain": {
        "javaHomePath": "",
