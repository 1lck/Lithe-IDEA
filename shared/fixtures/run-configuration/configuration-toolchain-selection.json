{
  "description": "Canonical reactor paths plus explicit Run overrides, without applying project defaults as configuration overrides or writing source documents.",
  "cases": [
    {
      "name": "explicit configuration paths override canonical project defaults",
      "request": {
        "path": ".",
        "configurationId": "maven-run",
        "localDocument": {
          "version": 2,
          "toolchain": {
            "java": {
              "homePath": "C:/Global JDK"
            },
            "maven": {
              "executablePath": "C:/Global Maven/bin/mvn.cmd",
              "javaHomePath": "C:/Global Maven JDK"
            },
            "pathOverrides": {
              "reactor": {
                "javaHomePath": "C:/Reactor JDK",
                "mavenExecutablePath": "C:/Reactor Maven/bin/mvn.cmd",
                "mavenJavaHomePath": "C:/Reactor Maven JDK"
              }
            }
          },
          "configurations": [
            {
              "id": "maven-run",
              "extensions": {
                "java": {
                  "homePath": " C:/Run JDK ",
                  "mavenExecutablePath": "C:/Run Maven/bin/mvn.cmd",
                  "mavenJavaHomePath": "C:/Run Maven JDK"
                }
              }
            }
          ]
        }
      },
      "generatedDocument": {
        "version": 2,
        "configurations": [
          {
            "id": "maven-run",
            "name": "Module",
            "provider": "maven.module",
            "execution": "task",
            "cwd": ".",
            "toolchains": {
              "java": "project-jdk",
              "maven": "project-maven"
            },
            "extensions": {
              "maven": {
                "module": "."
              }
            }
          }
        ]
      }
    },
