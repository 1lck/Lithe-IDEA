{
  "schema": "lithe.mcp.library.v1",
  "description": "Synthetic MCP library inputs shared by Core and macOS. Ledger sourceHash values written as {{sourceHash:<fileId>:<name>}} are replaced with the hash Core parses from that file before the case runs, so the fixture never stores secret-bearing content or brittle hashes. Every token-looking value is a placeholder.",
  "files": {
    "codexGlobal": {
      "id": "codex|global|",
      "source": "codex",
      "scope": "global",
      "path": "/fixture/home/.codex/config.toml",
      "content": "# user comment\n[mcp_servers.docs]\ncommand = \"npx\"\nargs = [\"-y\", \"docs-mcp\"]\n\n[mcp_servers.Server10]\nurl = \"https://example.invalid/ten\"\n\n[mcp_servers.server2]\nurl = \"https://example.invalid/two\"\n"
    },
    "claudeGlobal": {
      "id": "claude|global|",
      "source": "claude",
      "scope": "global",
      "path": "/fixture/home/.claude.json",
      "content": "{\n  \"mcpServers\": {\n    \"docs\": {\"command\": \"npx\", \"args\": [\"-y\", \"docs-mcp\"]},\n    \"server2\": {\"type\": \"http\", \"url\": \"https://example.invalid/other\"}\n  }\n}\n"
    },
    "claudeProject": {
      "id": "claude|project|/fixture/project",
      "source": "claude",
      "scope": "project",
      "projectPath": "/fixture/project",
      "path": "/fixture/home/.claude.json",
      "content": "{\n  \"projects\": {\n    \"/fixture/project\": {\n      \"mcpServers\": {\"lithe\": {\"command\": \"/fixture/bin/lithe-mcp\"}}\n    }\n  }\n}\n"
    },
    "codexBroken": {
      "id": "codex|project|/fixture/project",
      "source": "codex",
      "scope": "project",
      "projectPath": "/fixture/project",
      "path": "/fixture/project/.codex/config.toml",
      "content": "[mcp_servers.docs\ncommand = \"fixture-secret-should-not-echo\"\n"
    },
    "codexMissing": {
