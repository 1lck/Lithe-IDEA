{
  "version": 1,
  "description": "debug.planDisassemblyWindow / debug.reduceDisassemblyPage: the bounded request sequence a disassembly fetch sends and the step after every adapter reply. 'rejected' is an adapter response with success=false; 'failed' is a transport failure, timeout or cancellation.",
  "scenarios": [
    {
      "name": "first window drops adapter padding",
      "plan": {
        "direction": "around",
        "reference": "0x19b5f2a4c",
        "count": 96,
        "instructionsBefore": 24
      },
      "steps": [
        {
          "request": {
            "memoryReference": "0x19b5f2a4c",
            "instructionOffset": -24,
            "instructionCount": 96
          },
          "reply": {
            "kind": "instructions",
            "instructions": [
              {
                "address": "0x19b5f2a48",
                "instruction": "mov x16, #0x148"
              },
              {
                "address": "0x19b5f2a4c",
                "instruction": "svc #0x80"
              },
              {
                "address": "0xffffffffffffffff",
                "instruction": ""
              }
            ]
          },
          "expected": {
            "kind": "page",
            "keep": [
              0,
              1
            ],
            "exhausted": false
          }
        }
      ]
    },
    {
      "name": "first window refused at a negative offset retries from the instruction pointer",
      "plan": {
        "direction": "around",
        "reference": "0x19b5f2a4c",
        "count": 96,
        "instructionsBefore": 24
      },
      "steps": [
        {
          "request": {
            "memoryReference": "0x19b5f2a4c",
            "instructionOffset": -24,
            "instructionCount": 96
          },
          "reply": {
            "kind": "failed",
            "message": "negative offsets are not supported"
          },
          "expected": {
            "kind": "request"
          }
        },
        {
          "request": {
            "memoryReference": "0x19b5f2a4c",
            "instructionOffset": 0,
            "instructionCount": 96
          },
          "reply": {
            "kind": "instructions",
            "instructions": [
              {
                "address": "0x19b5f2a4c",
                "instruction": "svc #0x80"
              }
            ]
          },
          "expected": {
            "kind": "page",
            "keep": [
              0
            ],
            "exhausted": false
          }
        }
      ]
    },
    {
