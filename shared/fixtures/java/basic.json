{
  "name": "Java structure and run configuration scan",
  "requests": [
    {
      "command": "java.runConfigurations",
      "payload": {
        "paths": ["src/main/java/com/example/App.java"],
        "modulePaths": ["src"]
      },
      "expected": {
        "mainClass": "com.example.App",
        "kind": "springBoot",
        "modulePath": "src",
        "sourcePath": "src/main/java/com/example/App.java",
        "sourceSet": "main"
      }
    },
    {
      "command": "java.structure",
      "payload": {
        "source": "import a.A;\nimport b.B;\ninterface Service { String call(String value); }\n"
      },
      "expected": {
        "foldKind": "imports",
        "syntaxRoles": ["functionDeclaration", "keyword", "parameter", "punctuation", "type"]
      }
    }
  ]
}
