{
  "version": 1,
  "cases": [
    {
      "name": "create-with-another-shell",
      "existingSessionShell": "shell-a",
      "defaultShell": "shell-a",
      "selectedShell": "shell-b",
      "expected": {
        "newSessionShell": "shell-b",
        "newSessionIsActive": true,
        "existingSessionIsRunning": true,
        "defaultShell": "shell-a"
      }
    },
    {
      "name": "change-default",
      "existingSessionShell": "shell-a",
      "selectedDefaultShell": "shell-b",
      "expected": {
        "existingSessionShell": "shell-a",
        "existingSessionIsRunning": true,
        "nextSessionShell": "shell-b"
      }
    },
    {
      "name": "refresh-does-not-reset-preferences",
      "defaultShell": "shell-b",
      "detectedShells": ["shell-a"],
      "expected": {
        "defaultShell": "shell-b",
        "sessionsCreated": 0,
        "sessionsRestarted": 0
      }
    }
  ]
}
