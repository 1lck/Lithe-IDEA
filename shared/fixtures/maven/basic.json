{
  "name": "recursive Maven project scan",
  "request": {
    "command": "maven.scan",
    "payload": {
      "root": "/workspace",
      "paths": ["pom.xml", "module-a/pom.xml", "module-a/module-b/pom.xml"]
    }
  },
  "expected": {
    "relativePath": ".",
    "artifactId": "demo",
    "packaging": "pom",
    "sourceRoots": [],
    "modules": [
      {
        "relativePath": "module-a",
        "sourceRoots": [
          { "path": "src/main/java", "kind": "mainJava" },
          { "path": "src/main/resources", "kind": "mainResources" },
          { "path": "src/test/java", "kind": "testJava" },
          { "path": "src/test/resources", "kind": "testResources" },
          { "path": "target/generated-sources", "kind": "generatedMain" },
          { "path": "target/generated-test-sources", "kind": "generatedTest" }
        ],
        "modules": [
          {
            "relativePath": "module-a/module-b",
            "sourceRoots": [
              { "path": "src/main/java", "kind": "mainJava" },
              { "path": "src/main/resources", "kind": "mainResources" },
              { "path": "src/test/java", "kind": "testJava" },
              { "path": "src/test/resources", "kind": "testResources" },
              { "path": "target/generated-sources", "kind": "generatedMain" },
              { "path": "target/generated-test-sources", "kind": "generatedTest" }
            ]
          }
        ]
      }
    ],
    "profiles": [
      {
        "id": "dev",
        "isActiveByDefault": true
      }
    ],
    "hasWrapper": true
  }
}
