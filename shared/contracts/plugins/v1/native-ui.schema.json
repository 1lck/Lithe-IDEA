{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Lithe-IDEA/lithe-plugin-docs/main/contract/v1/native-ui.schema.json",
  "title": "Host-rendered native plugin UI schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "nodes",
    "actions",
    "toolbar",
    "contextMenu"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "kind": {
      "enum": [
        "tree",
        "list",
        "form"
      ]
    },
    "nodes": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildSystemID",
        "function"
      ],
      "properties": {
        "buildSystemID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "requiresSelection"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "refresh",
              "invoke"
            ]
          },
          "function": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "requiresSelection": {
            "type": "boolean"
          },
          "icon": {
            "description": "Optional host icon. Toolbar actions are icon-only; title supplies tooltip and accessibility text.",
            "allOf": [
              {
                "$ref": "plugin-manifest.schema.json#/$defs/uiIcon"
              },
              {
                "required": [
                  "host"
                ]
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "invoke"
                }
              }
            },
            "then": {
              "required": [
                "function"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "function"
                ]
              },
              "properties": {
                "requiresSelection": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "toolbar": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "contextMenu": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "buttons": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/formButton"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "children": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "kind": {
          "enum": [
            "input",
            "search",
            "editor",
            "select",
            "segmented",
            "checkbox",
            "stepper"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        },
        "placeholder": {
          "type": "string",
          "maxLength": 256
        },
        "enabled": {
          "type": "boolean"
        },
        "onCommit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "info": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "rows": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "minimum": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "maximum": {
          "type": "number",
          "minimum": -1000000000.0,
          "maximum": 1000000000.0
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "input",
                  "search"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "rows"
                  ]
                },
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "editor"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "placeholder"
                  ]
                },
                {
                  "required": [
                    "onCommit"
                  ]
                },
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "select"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "placeholder"
                  ]
                },
                {
                  "required": [
                    "rows"
                  ]
                },
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                }
              ]
            },
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "segmented"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              },
              "options": {
                "maxItems": 8
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "placeholder"
                  ]
                },
                {
                  "required": [
                    "rows"
                  ]
                },
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                }
              ]
            },
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "checkbox"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "placeholder"
                  ]
                },
                {
                  "required": [
                    "rows"
                  ]
                },
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "stepper"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "placeholder"
                  ]
                },
                {
                  "required": [
                    "rows"
                  ]
                }
              ]
            },
            "required": [
              "minimum",
              "maximum",
              "step"
            ]
          }
        }
      ]
    },
    "formButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "width": {
          "enum": [
            "content",
            "fill"
          ],
          "deprecated": true,
          "description": "Legacy placement hint accepted for compatibility. The host action group owns natural button widths, wrapping and spacing."
        },
        "primary": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "deprecated": true,
          "description": "Legacy placement hint accepted for compatibility. The host action group owns natural button widths, wrapping and spacing."
        },
        "info": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "form"
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "maxItems": 0
          },
          "controls": {},
          "contextMenu": {
            "maxItems": 0
          }
        },
        "anyOf": [
          {
            "required": [
              "controls"
            ],
            "properties": {
              "controls": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "buttons"
            ],
            "properties": {
              "buttons": {
                "minItems": 1
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "controls": {
            "maxItems": 0
          },
          "buttons": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "layout"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "layout"
          ]
        }
      },
      "then": {
        "properties": {
          "controls": {
            "items": {
              "not": {
                "required": [
                  "span"
                ]
              }
            }
          },
          "buttons": {
            "items": {
              "not": {
                "required": [
                  "span"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
