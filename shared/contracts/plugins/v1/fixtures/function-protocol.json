{
  "schemaVersion": 1,
  "protocol": "litheFunctions",
  "offer": { "versions": [1, 2, 3] },
  "negotiation": [
    {
      "name": "no answer leaves the protocol off",
      "capabilities": { "hoverProvider": true },
      "expected": { "functions": null }
    },
    {
      "name": "an answer next to litheBuild is independent of it",
      "capabilities": {
        "experimental": {
          "litheBuild": { "version": 1 },
          "litheFunctions": { "version": 1, "functions": [{ "id": "snapshot.refresh" }] }
        }
      },
      "expected": { "functions": ["snapshot.refresh"] }
    },
    {
      "name": "a version without functions starts with an empty registry",
      "capabilities": { "experimental": { "litheFunctions": { "version": 1 } } },
      "expected": { "functions": [] }
    },
    {
      "name": "unknown descriptor and answer fields are ignored",
      "capabilities": {
        "experimental": {
          "litheFunctions": {
            "version": 1,
            "future": true,
            "functions": [{ "id": "install.prepare", "title": "Prepare" }, { "id": "install.finish" }]
          }
        }
      },
      "expected": { "functions": ["install.finish", "install.prepare"] }
    },
    {
      "name": "version 2 negotiates the same registry and adds host services",
      "capabilities": { "experimental": { "litheFunctions": { "version": 2, "functions": [{ "id": "query.run" }] } } },
      "expected": { "functions": ["query.run"], "version": 2 }
    },
    {
      "name": "version 3 negotiates the same registry and adds contexts and capability discovery",
      "capabilities": { "experimental": { "litheFunctions": { "version": 3, "functions": [{ "id": "query.run" }] } } },
      "expected": { "functions": ["query.run"], "version": 3 }
    },
    {
      "name": "a version the host never offered is not negotiated",
      "capabilities": { "experimental": { "litheFunctions": { "version": 4 } } },
      "expected": { "functions": null }
    },
    {
      "name": "a version list is the offer shape, not an answer",
      "capabilities": { "experimental": { "litheFunctions": { "versions": [1] } } },
      "expected": { "functions": null }
    },
    {
      "name": "a malformed function ID rejects the whole answer",
      "capabilities": {
        "experimental": {
          "litheFunctions": { "version": 1, "functions": [{ "id": "ok" }, { "id": "Not-Valid" }] }
        }
      },
      "expected": { "functions": null }
    },
    {
      "name": "a duplicate function ID rejects the whole answer",
      "capabilities": {
        "experimental": {
          "litheFunctions": { "version": 1, "functions": [{ "id": "refresh" }, { "id": "refresh" }] }
        }
      },
      "expected": { "functions": null }
    }
  ],
  "registration": [
    {
      "name": "register adds functions",
      "method": "lithe/function/register",
      "registered": ["snapshot.refresh"],
      "params": { "functions": [{ "id": "snapshot.clear" }] },
      "expected": { "status": "accepted", "functions": ["snapshot.clear", "snapshot.refresh"], "removed": [] }
    },
    {
      "name": "registering an existing ID is refused",
      "method": "lithe/function/register",
      "registered": ["snapshot.refresh"],
      "params": { "functions": [{ "id": "snapshot.clear" }, { "id": "snapshot.refresh" }] },
      "expected": { "status": "rejected", "code": "plugin.function.invalidRegistration" }
    },
    {
      "name": "an empty registration is refused",
      "method": "lithe/function/register",
      "registered": [],
      "params": { "functions": [] },
      "expected": { "status": "rejected", "code": "plugin.function.invalidRegistration" }
    },
    {
      "name": "a function ID with a separator other than a dot is refused",
      "method": "lithe/function/register",
      "registered": [],
      "params": { "functions": [{ "id": "snapshot/refresh" }] },
      "expected": { "status": "rejected", "code": "plugin.function.invalidRegistration" }
    },
    {
      "name": "unregister withdraws functions",
      "method": "lithe/function/unregister",
      "registered": ["snapshot.clear", "snapshot.refresh"],
      "params": { "ids": ["snapshot.refresh"] },
      "expected": { "status": "accepted", "functions": ["snapshot.clear"], "removed": ["snapshot.refresh"] }
    },
    {
      "name": "unregistering an unknown ID is refused as a whole",
      "method": "lithe/function/unregister",
      "registered": ["snapshot.clear"],
      "params": { "ids": ["snapshot.clear", "snapshot.refresh"] },
      "expected": { "status": "rejected", "code": "plugin.function.invalidRegistration" }
    }
  ],
  "invocations": [
    {
      "name": "a registered function of the session's plugin is sent",
      "session": { "pluginID": "dev.lithe.fixture.maven", "negotiated": true, "functions": ["snapshot.refresh"] },
      "request": {
        "function": { "pluginID": "dev.lithe.fixture.maven", "functionID": "snapshot.refresh" },
        "params": { "project": "app" }
      },
      "expected": {
        "status": "sent",
        "method": "lithe/function/invoke",
        "params": { "functionID": "snapshot.refresh", "operationID": "operation-1", "params": { "project": "app" } }
      }
    },
    {
      "name": "a malformed reference is refused before the session is consulted",
      "session": { "pluginID": "dev.lithe.fixture.maven", "negotiated": true, "functions": ["snapshot.refresh"] },
      "request": {
        "function": { "pluginID": "dev.lithe.fixture.maven", "functionID": "lithe/build/model" },
        "params": {}
      },
      "expected": { "status": "refused", "code": "plugin.function.invalidReference" }
    },
    {
      "name": "params must be an object",
      "session": { "pluginID": "dev.lithe.fixture.maven", "negotiated": true, "functions": ["snapshot.refresh"] },
      "request": {
        "function": { "pluginID": "dev.lithe.fixture.maven", "functionID": "snapshot.refresh" },
        "params": ["app"]
      },
      "expected": { "status": "refused", "code": "plugin.function.invalidParams" }
    },
    {
      "name": "a session of another plugin is never reached",
      "session": { "pluginID": "dev.lithe.fixture.gradle", "negotiated": true, "functions": ["snapshot.refresh"] },
      "request": {
        "function": { "pluginID": "dev.lithe.fixture.maven", "functionID": "snapshot.refresh" },
        "params": {}
      },
      "expected": { "status": "refused", "code": "plugin.function.wrongPlugin" }
    },
    {
      "name": "a host-owned session serves no plugin functions",
      "session": { "pluginID": null, "negotiated": true, "functions": ["snapshot.refresh"] },
      "request": {
        "function": { "pluginID": "dev.lithe.fixture.maven", "functionID": "snapshot.refresh" },
        "params": {}
      },
      "expected": { "status": "refused", "code": "plugin.function.unavailable" }
    },
    {
      "name": "a backend that did not negotiate keeps serving its domain protocol only",
      "session": { "pluginID": "dev.lithe.fixture.maven", "negotiated": false, "functions": [] },
      "request": {
        "function": { "pluginID": "dev.lithe.fixture.maven", "functionID": "snapshot.refresh" },
        "params": {}
      },
      "expected": { "status": "refused", "code": "plugin.function.unavailable" }
    },
    {
      "name": "an unregistered function is unknown",
      "session": { "pluginID": "dev.lithe.fixture.maven", "negotiated": true, "functions": ["snapshot.clear"] },
      "request": {
        "function": { "pluginID": "dev.lithe.fixture.maven", "functionID": "snapshot.refresh" },
        "params": {}
      },
      "expected": { "status": "refused", "code": "plugin.function.unknown" }
    }
  ],
  "outcomes": [
    {
      "name": "a result is wrapped as value",
      "response": { "jsonrpc": "2.0", "id": 4, "result": { "snapshot": 3 } },
      "expected": { "result": { "value": { "snapshot": 3 } } }
    },
    {
      "name": "a null result is a result",
      "response": { "jsonrpc": "2.0", "id": 4, "result": null },
      "expected": { "result": { "value": null } }
    },
    {
      "name": "a response without result is invalid",
      "response": { "jsonrpc": "2.0", "id": 4 },
      "expected": {
        "error": { "code": "plugin.function.invalidResult", "message": "The plugin function returned no result." }
      }
    },
    {
      "name": "an error keeps the backend message and a well-formed plugin code",
      "response": {
        "jsonrpc": "2.0",
        "id": 4,
        "error": { "code": -32000, "message": "Snapshot is locked.", "data": { "code": "maven.snapshotLocked" } }
      },
      "expected": {
        "error": {
          "code": "plugin.function.failed",
          "message": "Snapshot is locked.",
          "pluginErrorCode": "maven.snapshotLocked"
        }
      }
    },
    {
      "name": "a malformed plugin code is dropped and an empty message replaced",
      "response": {
        "jsonrpc": "2.0",
        "id": 4,
        "error": { "code": -32000, "message": "", "data": { "code": "not a code" } }
      },
      "expected": {
        "error": { "code": "plugin.function.failed", "message": "The plugin function failed." }
      }
    }
  ],
  "progress": [
    {
      "name": "message and percentage are reported",
      "params": { "operationID": "operation-1", "message": "Reading snapshot", "percentage": 40 },
      "expected": { "operationID": "operation-1", "message": "Reading snapshot", "percentage": 40 }
    },
    {
      "name": "both fields are optional",
      "params": { "operationID": "operation-1" },
      "expected": { "operationID": "operation-1" }
    },
    {
      "name": "a percentage over 100 drops the report",
      "params": { "operationID": "operation-1", "percentage": 101 },
      "expected": null
    },
    {
      "name": "a report without operation ID is dropped",
      "params": { "message": "Working" },
      "expected": null
    }
  ],
  "backendRequests": [
    {
      "name": "a backend cannot ask the host to invoke a function",
      "method": "lithe/function/invoke",
      "expected": { "code": "plugin.function.recursiveCall" }
    },
    {
      "name": "a backend cannot ask the host for a build-domain operation",
      "method": "lithe/build/model",
      "expected": { "code": "plugin.function.recursiveCall" }
    },
    {
      "name": "version 1 offers no host capability",
      "method": "lithe/host/process.run",
      "expected": { "code": "plugin.host.unavailable" }
    },
    {
      "name": "other methods keep the ordinary JSON-RPC answer",
      "method": "workspace/applyEdit",
      "expected": { "code": null }
    }
  ],
  "hostRequests": [
    {
      "name": "version 1 sessions get no host service even when granted",
      "version": 1,
      "hostServices": ["credentials"],
      "method": "lithe/host/credentials/get",
      "params": { "key": "connection.prod" },
      "expected": { "rpcCode": -32601, "code": "plugin.host.unavailable" }
    },
    {
      "name": "a granted credential read is forwarded to the host",
      "version": 2,
      "hostServices": ["credentials"],
      "method": "lithe/host/credentials/get",
      "params": { "key": "connection.prod" },
      "expected": { "forward": "credentials" }
    },
    {
      "name": "a credential write carries the secret",
      "version": 2,
      "hostServices": ["credentials"],
      "method": "lithe/host/credentials/set",
      "params": { "key": "connection.prod:password", "secret": "s3cret" },
      "expected": { "forward": "credentials" }
    },
    {
      "name": "a credential delete names only the key",
      "version": 2,
      "hostServices": ["credentials"],
      "method": "lithe/host/credentials/delete",
      "params": { "key": "connection.prod" },
      "expected": { "forward": "credentials" }
    },
    {
      "name": "a service the plugin's permissions do not grant is refused",
      "version": 2,
      "hostServices": [],
      "method": "lithe/host/credentials/get",
      "params": { "key": "connection.prod" },
      "expected": { "rpcCode": -32601, "code": "plugin.host.permissionDenied" }
    },
    {
      "name": "a host method version 2 does not define is unavailable",
      "version": 2,
      "hostServices": ["credentials"],
      "method": "lithe/host/process.run",
      "params": {},
      "expected": { "rpcCode": -32601, "code": "plugin.host.unavailable" }
    },
    {
      "name": "a key outside the alphabet is invalid",
      "version": 2,
      "hostServices": ["credentials"],
      "method": "lithe/host/credentials/get",
      "params": { "key": "../other-plugin" },
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "an empty key is invalid",
      "version": 2,
      "hostServices": ["credentials"],
      "method": "lithe/host/credentials/delete",
      "params": { "key": "" },
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "a write without a string secret is invalid",
      "version": 2,
      "hostServices": ["credentials"],
      "method": "lithe/host/credentials/set",
      "params": { "key": "connection.prod", "secret": 42 },
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "unknown params are invalid so a later version can add them",
      "version": 2,
      "hostServices": ["credentials"],
      "method": "lithe/host/credentials/get",
      "params": { "key": "connection.prod", "scope": "global" },
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "capability discovery needs version 3",
      "version": 2,
      "hostServices": ["credentials"],
      "method": "lithe/host/getCapabilities",
      "expected": { "rpcCode": -32601, "code": "plugin.host.unavailable" }
    },
    {
      "name": "Core answers capability discovery with only the session's grants",
      "version": 3,
      "hostServices": ["workspace"],
      "method": "lithe/host/getCapabilities",
      "params": {},
      "expected": {
        "answer": {
          "protocolVersion": 3,
          "backendAuthority": "local",
          "services": {
            "host": { "methods": ["lithe/host/getCapabilities"] },
            "subscriptions": { "methods": ["lithe/host/subscriptions/dispose"] },
            "workspace": {
              "methods": [
                "lithe/host/workspace/listContexts",
                "lithe/host/workspace/getContext",
                "lithe/host/workspace/getFolders"
              ]
            }
          },
          "limits": { "pendingHostRequests": 16, "functionResultBytes": 1048576, "messageBytes": 1024 }
        }
      }
    },
    {
      "name": "capability discovery takes no params",
      "version": 3,
      "hostServices": [],
      "method": "lithe/host/getCapabilities",
      "params": { "services": ["credentials"] },
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "listing workspace contexts is forwarded when workspace.metadata is granted",
      "version": 3,
      "hostServices": ["workspace"],
      "method": "lithe/host/workspace/listContexts",
      "expected": { "forward": "workspace" }
    },
    {
      "name": "workspace contexts need the workspace.metadata grant",
      "version": 3,
      "hostServices": ["credentials"],
      "method": "lithe/host/workspace/listContexts",
      "params": {},
      "expected": { "rpcCode": -32601, "code": "plugin.host.permissionDenied" }
    },
    {
      "name": "workspace contexts need version 3 even when granted",
      "version": 2,
      "hostServices": ["workspace"],
      "method": "lithe/host/workspace/listContexts",
      "params": {},
      "expected": { "rpcCode": -32601, "code": "plugin.host.unavailable" }
    },
    {
      "name": "a context's folders are asked for by context ID and generation",
      "version": 3,
      "hostServices": ["workspace"],
      "method": "lithe/host/workspace/getFolders",
      "params": { "context": { "contextID": "w-3f2a", "generation": 2 } },
      "expected": { "forward": "workspace" }
    },
    {
      "name": "one context is asked for by context ID and generation",
      "version": 3,
      "hostServices": ["workspace"],
      "method": "lithe/host/workspace/getContext",
      "params": { "context": { "contextID": "w-3f2a", "generation": 2 } },
      "expected": { "forward": "workspace" }
    },
    {
      "name": "a context without a generation is invalid",
      "version": 3,
      "hostServices": ["workspace"],
      "method": "lithe/host/workspace/getFolders",
      "params": { "context": { "contextID": "w-3f2a" } },
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "a generation is positive",
      "version": 3,
      "hostServices": ["workspace"],
      "method": "lithe/host/workspace/getContext",
      "params": { "context": { "contextID": "w-3f2a", "generation": 0 } },
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "a context ID outside the alphabet is invalid",
      "version": 3,
      "hostServices": ["workspace"],
      "method": "lithe/host/workspace/getContext",
      "params": { "context": { "contextID": "../w", "generation": 1 } },
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "a context reference has no other fields",
      "version": 3,
      "hostServices": ["workspace"],
      "method": "lithe/host/workspace/getContext",
      "params": { "context": { "contextID": "w-3f2a", "generation": 1, "path": "/tmp" } },
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "a subscription is disposed by its ID without any grant",
      "version": 3,
      "hostServices": [],
      "method": "lithe/host/subscriptions/dispose",
      "params": { "subscriptionID": "watch-1" },
      "expected": { "forward": "subscriptions" }
    },
    {
      "name": "disposing needs a subscription ID",
      "version": 3,
      "hostServices": [],
      "method": "lithe/host/subscriptions/dispose",
      "params": {},
      "expected": { "rpcCode": -32602, "code": "plugin.host.invalidParams" }
    },
    {
      "name": "credentials keep their version 2 rules in version 3",
      "version": 3,
      "hostServices": ["credentials"],
      "method": "lithe/host/credentials/get",
      "params": { "key": "connection.prod" },
      "expected": { "forward": "credentials" }
    },
    {
      "name": "a method no version defines is unavailable",
      "version": 3,
      "hostServices": ["credentials", "workspace"],
      "method": "lithe/host/process/run",
      "params": {},
      "expected": { "rpcCode": -32601, "code": "plugin.host.unavailable" }
    }
  ],
  "invocationContexts": [
    {
      "name": "a version 3 backend receives the call's context",
      "version": 3,
      "params": { "functionID": "query.run", "operationID": "7", "params": {} },
      "context": { "contextID": "w-3f2a", "generation": 2 },
      "expected": {
        "params": { "functionID": "query.run", "operationID": "7", "params": {}, "context": { "contextID": "w-3f2a", "generation": 2 } }
      }
    },
    {
      "name": "an older backend receives the call unchanged",
      "version": 2,
      "params": { "functionID": "query.run", "operationID": "7", "params": {} },
      "context": { "contextID": "w-3f2a", "generation": 2 },
      "expected": { "params": { "functionID": "query.run", "operationID": "7", "params": {} } }
    },
    {
      "name": "a call without a context is unchanged",
      "version": 3,
      "params": { "functionID": "query.run", "operationID": "7", "params": {} },
      "expected": { "params": { "functionID": "query.run", "operationID": "7", "params": {} } }
    },
    {
      "name": "a malformed context never leaves Core",
      "version": 3,
      "params": { "functionID": "query.run", "operationID": "7", "params": {} },
      "context": { "contextID": "w-3f2a", "generation": -1 },
      "expected": { "code": "plugin.function.invalidParams" }
    }
  ],
  "hostFailures": [
    { "name": "no code is a generic failure", "code": null, "expected": { "code": "plugin.host.failed", "rpcCode": -32603 } },
    { "name": "a closed or replaced context", "code": "plugin.host.contextExpired", "expected": { "code": "plugin.host.contextExpired", "rpcCode": -32603 } },
    { "name": "a remote authority without the operation", "code": "plugin.host.authorityUnsupported", "expected": { "code": "plugin.host.authorityUnsupported", "rpcCode": -32603 } },
    { "name": "a stale versioned edit", "code": "plugin.host.versionConflict", "expected": { "code": "plugin.host.versionConflict", "rpcCode": -32603 } },
    { "name": "a host limit", "code": "plugin.host.limitExceeded", "expected": { "code": "plugin.host.limitExceeded", "rpcCode": -32603 } },
    { "name": "the host stopped the request", "code": "plugin.host.cancelled", "expected": { "code": "plugin.host.cancelled", "rpcCode": -32800 } },
    { "name": "the host's deadline passed", "code": "plugin.host.timeout", "expected": { "code": "plugin.host.timeout", "rpcCode": -32603 } },
    { "name": "params the service itself refuses", "code": "plugin.host.invalidParams", "expected": { "code": "plugin.host.invalidParams", "rpcCode": -32602 } },
    { "name": "the user withheld consent", "code": "plugin.host.permissionDenied", "expected": { "code": "plugin.host.permissionDenied", "rpcCode": -32601 } },
    { "name": "a service the host turned off", "code": "plugin.host.unavailable", "expected": { "code": "plugin.host.unavailable", "rpcCode": -32601 } },
    { "name": "a host cannot borrow a function code", "code": "plugin.function.unknown", "expected": { "code": "plugin.host.failed", "rpcCode": -32603 } },
    { "name": "a host cannot report a backend exit to the backend", "code": "plugin.backend.exited", "expected": { "code": "plugin.host.failed", "rpcCode": -32603 } }
  ]
}
