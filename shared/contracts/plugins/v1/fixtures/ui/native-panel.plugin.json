{
  "schemaVersion": 2,
  "id": "dev.lithe.fixture.native-panel",
  "displayName": "Sample Build",
  "version": "0.1.0",
  "pluginAPIVersion": 3,
  "requires": {
    "buildProviders": 1,
    "buildSystems": 1,
    "serverProcess": 1,
    "ui": 3
  },
  "vendor": {
    "id": "org.example",
    "displayName": "Example",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": [
    "languageServer.launch",
    "process.build",
    "ui.contribute"
  ],
  "activationEvents": [
    "onBuildSystem:sample",
    "onView:dev.lithe.fixture.native-panel.explorer"
  ],
  "languages": [],
  "buildSystems": [
    {
      "id": "sample",
      "displayName": "Sample",
      "detection": {
        "markers": [
          "lithe-sample.json"
        ],
        "nesting": "outermost"
      },
      "invocation": {
        "executables": [
          {
            "kind": "command",
            "command": "node"
          }
        ]
      },
      "provider": {
        "launch": {
          "kind": "runtime",
          "tool": "node",
          "minimumVersion": "20.3",
          "entry": "backend/main.mjs"
        },
        "arguments": [
          "--state",
          "${workspaceStateDir}"
        ],
        "executesProjectCode": true,
        "mayUseNetwork": false
      },
      "model": {
        "source": "provider"
      },
      "tasks": [
        {
          "id": "build",
          "displayName": "Build",
          "group": "build",
          "scopes": [
            "workspace"
          ],
          "arguments": [
            "--version"
          ]
        }
      ],
      "dependencies": {
        "source": "provider",
        "scopes": [
          "workspace",
          "project"
        ]
      },
      "sync": {
        "watch": [
          "lithe-sample.json"
        ]
      }
    }
  ],
  "ui": {
    "toolWindows": [
      {
        "id": "dev.lithe.fixture.native-panel.explorer",
        "title": "Sample Explorer",
        "placement": "right",
        "native": {
          "schemaVersion": 1,
          "id": "explorer",
          "kind": "tree",
          "nodes": [],
          "source": {
            "buildSystemID": "sample",
            "function": "ui.nodes"
          },
          "actions": [
            {
              "id": "refresh",
              "title": "Refresh",
              "kind": "refresh",
              "requiresSelection": false,
              "icon": {
                "host": "refresh"
              }
            },
            {
              "id": "inspect",
              "title": "Inspect",
              "kind": "invoke",
              "function": "ui.inspect",
              "requiresSelection": true,
              "icon": {
                "host": "search"
              }
            }
          ],
          "toolbar": [
            "refresh",
            "inspect"
          ],
          "contextMenu": [
            "inspect"
          ]
        }
      }
    ]
  }
}
