{
  "schemaVersion": 2,
  "id": "dev.lithe.fixture.build-provider-debug-preparation",
  "displayName": "Native Debug Preparation Fixture",
  "version": "0.1.0",
  "pluginAPIVersion": 4,
  "requires": {
    "buildProviders": 5,
    "buildSystems": 1,
    "serverProcess": 1,
    "settings": 1,
    "debugAdapters": 2
  },
  "vendor": {
    "id": "org.example",
    "displayName": "Example",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": [
    "languageServer.launch",
    "process.build",
    "debug.launch"
  ],
  "activationEvents": [
    "onBuildSystem:gradle",
    "onDebug:native"
  ],
  "languages": [],
  "settings": [
    {
      "id": "providerHeapMB",
      "type": "integer",
      "title": "Provider memory",
      "description": "Upper bound of the Gradle provider's heap.",
      "default": 1024,
      "minimum": 256,
      "maximum": 8192,
      "unit": "MB"
    }
  ],
  "buildSystems": [
    {
      "id": "gradle",
      "displayName": "Gradle",
      "detection": {
        "markers": [
          "build.gradle",
          "build.gradle.kts",
          "settings.gradle",
          "settings.gradle.kts"
        ],
        "nesting": "outermost",
        "priority": 60
      },
      "invocation": {
        "executables": [
          {
            "kind": "projectFile",
            "path": "gradlew",
            "requires": [
              "gradle/wrapper/gradle-wrapper.properties"
            ],
            "platforms": [
              "macos",
              "linux"
            ]
          },
          {
            "kind": "projectFile",
            "path": "gradlew.bat",
            "requires": [
              "gradle/wrapper/gradle-wrapper.properties"
            ],
            "platforms": [
              "windows"
            ]
          },
          {
            "kind": "command",
            "command": "gradle"
          }
        ],
        "runtimeDependencies": [
          {
            "id": "java",
            "minimumVersion": "17"
          }
        ],
        "globalArguments": [
          "--console=plain",
          "${optionArguments}"
        ]
      },
      "provider": {
        "launch": {
          "kind": "runtime",
          "tool": "java",
          "minimumVersion": "17",
          "runtimeArguments": [
            "-Xmx${setting:providerHeapMB}m"
          ],
          "entry": "provider/gradle-tooling-provider.jar"
        },
        "arguments": [
          "--stdio",
          "--cache",
          "${workspaceStateDir}/tooling"
        ],
        "initializationOptions": {
          "initScript": "${pluginDir}/provider/lithe-model.init.gradle"
        },
        "executesProjectCode": true,
        "mayUseNetwork": true
      },
      "options": [
        {
          "id": "offline",
          "displayName": "Offline",
          "kind": "boolean",
          "arguments": [
            "--offline"
          ]
        }
      ],
      "model": {
        "source": "provider"
      },
      "tasks": [
        {
          "id": "build",
          "displayName": "Build",
          "group": "build",
          "scopes": [
            "workspace",
            "project",
            "target"
          ],
          "source": "provider",
          "arguments": []
        },
        {
          "id": "custom",
          "displayName": "Custom",
          "group": "other",
          "scopes": [
            "workspace"
          ],
          "source": "provider",
          "requiresUserArguments": true,
          "arguments": []
        }
      ],
      "dependencies": {
        "source": "provider",
        "scopes": [
          "workspace",
          "project"
        ]
      },
      "sync": {
        "watch": [
          "build.gradle",
          "build.gradle.kts",
          "gradle.properties",
          "gradle/libs.versions.toml",
          "settings.gradle",
          "settings.gradle.kts"
        ]
      },
      "layout": {
        "excluded": [
          ".gradle",
          "build"
        ]
      },
      "test": {
        "source": "provider",
        "scopes": [
          "workspace",
          "project",
          "target"
        ],
        "filters": [
          "suite",
          "case"
        ],
        "arguments": [],
        "results": {
          "decoder": "junitXml",
          "reports": [
            "build/test-results/**/*.xml"
          ]
        },
        "discovery": true
      },
      "run": [
        {
          "id": "application",
          "source": "provider",
          "name": "Run Application",
          "fromTargets": {
            "tags": [
              "application"
            ]
          },
          "arguments": [],
          "debug": {
            "adapter": "native"
          }
        }
      ]
    }
  ],
  "debugAdapters": [
    {
      "id": "native",
      "displayName": "Native DAP",
      "requests": [
        "launch"
      ],
      "selectors": [
        {
          "targetKinds": [
            "executable"
          ]
        }
      ],
      "configurationTypes": [
        "native"
      ],
      "configurations": {
        "launch": {
          "targetBindings": {
            "program": "target.path",
            "cwd": "target.workingDirectory",
            "args": "target.arguments",
            "env": "target.environment"
          }
        }
      },
      "launch": {
        "process": {
          "launch": {
            "kind": "systemCommand",
            "commands": [
              "example-dap"
            ]
          }
        },
        "transport": "stdio"
      }
    }
  ]
}
