{
  "schemaVersion": 2,
  "id": "dev.lithe.fixture.editor-navigation",
  "displayName": "Editor Navigation Fixture",
  "version": "1.0.0",
  "pluginAPIVersion": 3,
  "requires": {
    "languages": 1,
    "languageServers": 1,
    "serverProcess": 1,
    "settings": 3
  },
  "vendor": {
    "id": "dev.lithe",
    "displayName": "Lithe",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": [
    "languageServer.launch"
  ],
  "activationEvents": [
    "onLanguage:fixture"
  ],
  "languages": [
    {
      "id": "fixture",
      "displayName": "Fixture",
      "fileExtensions": [
        "fixture"
      ]
    }
  ],
  "languageServers": [
    {
      "languageID": "fixture",
      "launch": {
        "kind": "systemCommand",
        "commands": [
          "fixture-language-server"
        ]
      }
    }
  ],
  "settings": [
    {
      "id": "navigation",
      "type": "boolean",
      "title": "Navigation",
      "default": false,
      "effect": "editorNavigation",
      "page": {
        "languageID": "fixture"
      }
    }
  ]
}
