{
  "schemaVersion": 2,
  "id": "dev.lithe.fixture.publisher-bundled",
  "displayName": "Publisher and bundled trust fixture",
  "version": "1.0.0",
  "pluginAPIVersion": 3,
  "requires": {"languages": 1, "languageServers": 1, "serverProcess": 1, "packageTrust": 1},
  "vendor": {
    "id": "dev.lithe",
    "displayName": "Lithe",
    "signatureRequirement": "publisherPackage",
    "bundledSignatureRequirement": "sameTeamAsHost"
  },
  "permissions": ["languageServer.launch"],
  "activationEvents": ["onLanguage:fixture"],
  "languages": [{"id": "fixture", "displayName": "Fixture", "fileExtensions": ["fixture"]}],
  "languageServers": [{
    "languageID": "fixture",
    "launch": {"kind": "runtime", "tool": "java", "packagedRuntime": "runtime/${arch}/bin/java", "entry": "server.jar"},
    "arguments": []
  }]
}
