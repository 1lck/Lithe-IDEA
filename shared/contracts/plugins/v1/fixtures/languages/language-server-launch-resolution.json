{
  "schemaVersion": 1,
  "description": "Golden launch of a language server whose backend resolves the command line (serverProcess 3). `languageServerLaunchPlan` is the first step: Core names the function to call and its params. `decodeLaunch` is the second step: Core bounds the function's `result` and returns the plan the host starts. A case runs against `plugin` and `languageID` unless it names its own, with `request` changed by `requestEdits` (JSON Pointer `set` or `remove`). `expected` is the command's data object, or `{status: \"rejected\", code}` for the stable rejection code. `resolveParams.platform.os` is the host's operating system and is not compared.",
  "plugin": "language-server-backend-launch.plugin.json",
  "languageID": "scala",
  "request": {
    "pluginDirectory": "/plugins/metals",
    "stateDirectory": "/state/metals",
    "workspaceStateDirectory": "/state/metals/workspaces/abc",
    "logDirectory": "/logs/metals",
    "temporaryDirectory": "/tmp/metals",
    "architecture": "arm64"
  },
  "cases": [
    {
      "name": "the first step asks the backend to resolve the launch",
      "operation": "languageServerLaunchPlan",
      "expected": {
        "status": "ok",
        "plan": {
          "owner": { "pluginID": "dev.lithe.fixture.language-server-backend-launch", "version": "0.1.0" },
          "launch": {
            "kind": "backend",
            "function": "metals.resolveLaunch",
            "timeoutMilliseconds": 30000
          },
          "resolveParams": {
            "serverID": "scala",
            "platform": {
              "arch": "arm64"
            },
            "stateDirectory": "/state/metals",
            "workspaceStateDirectory": "/state/metals/workspaces/abc",
            "logDirectory": "/logs/metals",
            "temporaryDirectory": "/tmp/metals",
            "settings": {}
          },
          "arguments": [],
          "validationArguments": [],
          "runtimeRequirements": [],
          "requiredDirectories": [
            "state",
            "workspaceState",
            "log",
            "temporary"
          ],
          "requiredPackagePaths": [],
          "sessionPolicy": {
            "serverID": "scala",
            "requestMethods": [
              "textDocument/definition",
              "workspace/executeCommand"
            ],
            "commands": [
              "build-connect",
              "build-import",
              "doctor-run"
            ],
            "serializedCommands": [
              "build-import"
            ],
            "forwardNotifications": [
              "metals/executeClientCommand",
              "metals/status"
            ],
            "remote": "unsupported",
            "gates": [],
            "state": {
              "scope": "workspace",
              "retention": {
                "maxEntries": 8,
                "maxAgeDays": 30
              }
            }
          }
        }
      }
    },
    {
      "name": "the first step needs the temporary directory",
      "operation": "languageServerLaunchPlan",
      "requestEdits": [
        {
          "op": "remove",
          "path": "/temporaryDirectory"
        }
      ],
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.invalidRequest"
      }
    },
    {
      "name": "the first step refuses an unknown architecture",
      "operation": "languageServerLaunchPlan",
      "requestEdits": [
        {
          "op": "set",
          "path": "/architecture",
          "value": "sparc"
        }
      ],
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.invalidRequest"
      }
    },
    {
      "name": "a packaged answer becomes a start plan with its gates",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        },
        "arguments": [
          "-Dmetals.client=lithe"
        ],
        "environment": {
          "COURSIER_CACHE": "/tmp/metals/coursier"
        },
        "initializationOptions": {
          "isHttpEnabled": false
        },
        "workspaceConfiguration": {
          "metals": {
            "showInferredType": true
          }
        },
        "gates": [
          {
            "id": "build-imported",
            "until": "notification",
            "method": "metals/status",
            "match": {
              "text": "Indexing complete"
            }
          }
        ],
        "writablePaths": [
          "/tmp/metals/coursier",
          "/state/metals/workspaces/abc/.bloop"
        ]
      },
      "expected": {
        "status": "ok",
        "plan": {
          "launch": {
            "kind": "packaged",
            "path": "server/bin/metals"
          },
          "arguments": [
            "-Dmetals.client=lithe"
          ],
          "validationArguments": [],
          "runtimeRequirements": [],
          "environment": {
            "COURSIER_CACHE": "/tmp/metals/coursier"
          },
          "writablePaths": [
            "/state/metals/workspaces/abc/.bloop",
            "/tmp/metals/coursier"
          ],
          "requiredDirectories": [],
          "requiredPackagePaths": [
            "server/bin/metals"
          ],
          "initializationOptions": {
            "isHttpEnabled": false
          },
          "workspaceConfiguration": {
            "metals": {
              "showInferredType": true
            }
          },
          "sessionPolicy": {
            "serverID": "scala",
            "requestMethods": [
              "textDocument/definition",
              "workspace/executeCommand"
            ],
            "commands": [
              "build-connect",
              "build-import",
              "doctor-run"
            ],
            "serializedCommands": [
              "build-import"
            ],
            "forwardNotifications": [
              "metals/executeClientCommand",
              "metals/status"
            ],
            "remote": "unsupported",
            "gates": [
              {
                "id": "build-imported",
                "until": "notification",
                "method": "metals/status",
                "match": {
                  "text": "Indexing complete"
                }
              }
            ],
            "state": {
              "scope": "workspace",
              "retention": {
                "maxEntries": 8,
                "maxAgeDays": 30
              }
            }
          }
        }
      }
    },
    {
      "name": "a tool answer names a declared tool definition",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "tool",
          "tool": "coursier"
        },
        "arguments": [
          "launch",
          "metals"
        ]
      },
      "expected": {
        "status": "ok",
        "plan": {
          "launch": {
            "kind": "tool",
            "tool": "coursier"
          },
          "arguments": [
            "launch",
            "metals"
          ],
          "validationArguments": [],
          "runtimeRequirements": [],
          "environment": {},
          "writablePaths": [],
          "requiredDirectories": [],
          "requiredPackagePaths": [],
          "sessionPolicy": {
            "serverID": "scala",
            "requestMethods": [
              "textDocument/definition",
              "workspace/executeCommand"
            ],
            "commands": [
              "build-connect",
              "build-import",
              "doctor-run"
            ],
            "serializedCommands": [
              "build-import"
            ],
            "forwardNotifications": [
              "metals/executeClientCommand",
              "metals/status"
            ],
            "remote": "unsupported",
            "gates": [],
            "state": {
              "scope": "workspace",
              "retention": {
                "maxEntries": 8,
                "maxAgeDays": 30
              }
            }
          }
        }
      }
    },
    {
      "name": "an executable outside the package is refused",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "../bin/metals"
        }
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.outsidePackage"
      }
    },
    {
      "name": "a tool the plugin does not define is refused",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "tool",
          "tool": "sbt"
        }
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.undeclaredTool"
      }
    },
    {
      "name": "a writable path outside the host directories is refused",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        },
        "writablePaths": [
          "/home/user/.metals"
        ]
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.unwritablePath"
      }
    },
    {
      "name": "a writable path cannot climb out of a host directory",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        },
        "writablePaths": [
          "/state/metals/../other"
        ]
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.unwritablePath"
      }
    },
    {
      "name": "an unknown member of the answer is refused",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        },
        "directories": {}
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.invalidResult"
      }
    },
    {
      "name": "initialization options are an object",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        },
        "initializationOptions": [
          "not",
          "an",
          "object"
        ]
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.invalidResult"
      }
    },
    {
      "name": "an argument cannot contain NUL",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        },
        "arguments": [
          "a\u0000b"
        ]
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.invalidResult"
      }
    },
    {
      "name": "an environment name cannot contain an equals sign",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        },
        "environment": {
          "A=B": "x"
        }
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.invalidResult"
      }
    },
    {
      "name": "gate IDs are unique",
      "operation": "decodeLaunch",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        },
        "gates": [
          {
            "id": "build-imported",
            "until": "notification",
            "method": "metals/status",
            "match": {
              "text": "Indexing complete"
            }
          },
          {
            "id": "build-imported",
            "until": "notification",
            "method": "metals/status",
            "match": {
              "text": "Indexing complete"
            }
          }
        ]
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.invalidResult"
      }
    },
    {
      "name": "a server the backend does not launch has no answer to decode",
      "operation": "decodeLaunch",
      "plugin": "language-packaged-server.plugin.json",
      "languageID": "php",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        }
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.notBackend"
      }
    },
    {
      "name": "a language without a server has no answer to decode",
      "operation": "decodeLaunch",
      "languageID": "hack",
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        }
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.unavailable"
      }
    },
    {
      "name": "decoding needs the same directories the first step did",
      "operation": "decodeLaunch",
      "requestEdits": [
        {
          "op": "remove",
          "path": "/logDirectory"
        }
      ],
      "result": {
        "executable": {
          "kind": "packaged",
          "path": "server/bin/metals"
        }
      },
      "expected": {
        "status": "rejected",
        "code": "plugin.launch.invalidRequest"
      }
    }
  ]
}
