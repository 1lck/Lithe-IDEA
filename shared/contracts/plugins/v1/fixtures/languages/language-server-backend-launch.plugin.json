{
  "schemaVersion": 2,
  "id": "dev.lithe.fixture.language-server-backend-launch",
  "displayName": "Backend Launched Language Server Fixture",
  "version": "0.1.0",
  "pluginAPIVersion": 4,
  "requires": {
    "backend": 2,
    "executableResolution": 2,
    "languageServers": 3,
    "languages": 1,
    "serverProcess": 3,
    "toolDefinitions": 1
  },
  "vendor": {
    "id": "org.example",
    "displayName": "Example",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": [
    "backend.launch",
    "languageServer.launch",
    "languageServer.request"
  ],
  "activationEvents": [
    "onLanguage:scala"
  ],
  "languages": [
    {
      "id": "scala",
      "displayName": "Scala",
      "fileExtensions": [
        "scala",
        "sc"
      ],
      "projectFileNames": [
        "build.sbt"
      ]
    }
  ],
  "toolDefinitions": [
    {
      "id": "coursier",
      "displayName": "Coursier",
      "executableLayouts": [
        {
          "path": "bin/cs"
        }
      ],
      "executables": [
        {
          "id": "shell",
          "kind": "command",
          "command": "cs"
        }
      ],
      "version": {
        "arguments": [
          "--version"
        ],
        "pattern": "(\\d+(?:\\.\\d+)*)"
      },
      "commands": [
        "cs"
      ],
      "launch": [
        "${executable}",
        "${arguments}"
      ]
    }
  ],
  "languageServers": [
    {
      "languageID": "scala",
      "launch": {
        "kind": "backend",
        "function": "metals.resolveLaunch",
        "timeoutMilliseconds": 30000
      },
      "requestMethods": [
        "textDocument/definition",
        "workspace/executeCommand"
      ],
      "commands": [
        "build-connect",
        "build-import",
        "doctor-run"
      ],
      "serializedCommands": [
        "build-import"
      ],
      "forwardNotifications": [
        "metals/executeClientCommand",
        "metals/status"
      ],
      "state": {
        "scope": "workspace",
        "retention": {
          "maxEntries": 8,
          "maxAgeDays": 30
        }
      },
      "remote": "unsupported"
    }
  ],
  "backend": {
    "launch": {
      "kind": "packaged",
      "path": "bin/backend"
    },
    "arguments": [
      "--state",
      "${stateDir}"
    ]
  }
}
