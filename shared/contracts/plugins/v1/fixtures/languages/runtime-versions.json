{
  "schemaVersion": 1,
  "description": "Golden outcomes of plugins.declarative.checkRuntimeVersion. `request` is the command payload; `expected` is the returned `check` object, or a rejection code.",
  "cases": [
    { "name": "node version with a leading v", "request": { "tool": "node", "minimumVersion": "18.17", "output": "v20.11.0" }, "expected": { "satisfied": true, "version": "20.11.0" } },
    { "name": "node minor below the requirement", "request": { "tool": "node", "minimumVersion": "18.17", "output": "v18.16.1" }, "expected": { "satisfied": false, "version": "18.16.1" } },
    { "name": "node meets a major-only requirement", "request": { "tool": "node", "minimumVersion": "20", "output": "v20.0.0" }, "expected": { "satisfied": true, "version": "20.0.0" } },
    { "name": "a newer node major satisfies the requirement", "request": { "tool": "node", "minimumVersion": "18", "output": "v22.3.0" }, "expected": { "satisfied": true, "version": "22.3.0" } },
    { "name": "the first line with a digit carries the version", "request": { "tool": "node", "minimumVersion": "20", "output": "warning: using a custom runtime\nv18.20.4\nv22.0.0" }, "expected": { "satisfied": false, "version": "18.20.4" } },
    { "name": "requirement names more components than the runtime reports", "request": { "tool": "node", "minimumVersion": "21.0.1", "output": "v21" }, "expected": { "satisfied": false, "version": "21" } },
    { "name": "output without a version", "request": { "tool": "node", "minimumVersion": "18", "output": "node: command not found" }, "expected": { "satisfied": false } },
    { "name": "a tool that cannot start an entry file", "request": { "tool": "go", "minimumVersion": "1.22", "output": "go version go1.22.3 darwin/arm64" }, "expectedCode": "plugin.runtime.unsupported" },
    { "name": "a tool definition checks its own version", "request": { "tool": "fixture-sdk", "minimumVersion": "21", "output": "fixture-sdk 21.0.4" }, "expectedCode": "plugin.runtime.unsupported" },
    { "name": "malformed requirement", "request": { "tool": "node", "minimumVersion": "21+", "output": "v21.0.0" }, "expectedCode": "plugin.manifest.invalid" }
  ]
}
