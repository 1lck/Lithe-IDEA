      "form": {
        "projectName": "demo",
        "tools": {
          "python": [
            {"home": "/opt/python-3.10", "executable": "/opt/python-3.10/bin/python3", "version": "3.10.14"}
          ]
        }
      },
      "expected": {
        "status": "rejected",
