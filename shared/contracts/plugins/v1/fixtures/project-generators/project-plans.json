              "environment": {"NODE": "/opt/node-22/bin/node"},
              "collect": null,
              "mayUseNetwork": true,
              "timeoutSeconds": 600
            }
          ],
          "openFiles": [],
          "runtimes": [],
          "toolPins": [
            {
              "field": "node",
              "tool": "node",
              "pinAs": "project",
              "home": "/opt/node-22",
              "executable": "/opt/node-22/bin/node"
            }
          ],
          "usesNetwork": true
        }
      }
    },
    {
      "name": "tool form treats a release with fewer trailing zeros as the same release",
      "manifest": "project-generator-tool-field.plugin.json",
      "operation": "generatorForm",
      "generatorID": "node-app",
      "form": {
        "projectName": "demo",
        "tools": {
          "node": [
            {"home": "/opt/node-18", "executable": "/opt/node-18/bin/node", "version": "18"},
            {"home": "/opt/node-18.0", "executable": "/opt/node-18.0/bin/node", "version": "18.0.0"}
          ]
        }
      },
      "expected": {
        "status": "ok",
        "form": {
          "projectName": {"problem": null},
          "fields": [
            {
              "id": "node",
              "visible": true,
              "value": "/opt/node-18",
              "installations": [
                {"home": "/opt/node-18", "executable": "/opt/node-18/bin/node", "version": "18", "meetsMinimum": true},
                {"home": "/opt/node-18.0", "executable": "/opt/node-18.0/bin/node", "version": "18.0.0", "meetsMinimum": true}
              ]
            }
          ],
          "activeRequirements": [],
          "valid": true
        }
      }
    },
