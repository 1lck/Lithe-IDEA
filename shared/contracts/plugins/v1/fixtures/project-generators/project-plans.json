    {
      "name": "plan pins an optional tool that has an installation",
      "manifest": "project-generator-tool-field.plugin.json",
      "operation": "generationPlan",
      "generatorID": "node-app",
      "form": {
        "projectName": "demo",
        "tools": {
          "node": [
            {"home": "/opt/node-22", "executable": "/opt/node-22/bin/node", "version": "22.11.0"}
