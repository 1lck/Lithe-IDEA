    {
      "name": "plan refuses an old optional tool the user chose",
      "manifest": "project-generator-tool-field.plugin.json",
      "operation": "generationPlan",
      "generatorID": "node-app",
      "form": {
        "projectName": "demo",
        "values": {"node": "/opt/node-16"},
        "tools": {
          "node": [
            {"home": "/opt/node-16", "executable": "/opt/node-16/bin/node", "version": "16.20.2"}
