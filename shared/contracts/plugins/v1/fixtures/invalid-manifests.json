      "expectedCode": "plugin.integration.unsupported"
    },
    {
      "name": "host-integration model without a host integration",
      "base": "maven-build.plugin.json",
      "edits": [{ "op": "remove", "path": "/buildSystems/0/hostIntegration" }],
      "expectedCode": "plugin.manifest.invalid"
    },
    {
      "name": "option arguments placed twice",
      "base": "cargo-build.plugin.json",
      "edits": [{ "op": "set", "path": "/buildSystems/0/tasks/0/arguments", "value": ["build", "${optionArguments}", "${optionArguments:release}"] }],
      "expectedCode": "plugin.template.invalid"
    },
    {
      "name": "option arguments name an undeclared option",
      "base": "cargo-build.plugin.json",
      "edits": [{ "op": "set", "path": "/buildSystems/0/tasks/2/arguments", "value": ["clean", "${optionArguments:profile}"] }],
      "expectedCode": "plugin.template.invalid"
    },
    {
      "name": "target variable without its guard",
      "base": "cargo-build.plugin.json",
      "edits": [{ "op": "set", "path": "/buildSystems/0/test/arguments", "value": ["test", "${target.name}"] }],
      "expectedCode": "plugin.template.invalid"
    },
    {
      "name": "test case variable without its guard",
      "base": "cargo-build.plugin.json",
      "edits": [{ "op": "set", "path": "/buildSystems/0/test/arguments", "value": ["test", "--", "${test.case}"] }],
      "expectedCode": "plugin.template.invalid"
    },
    {
      "name": "test variables outside a test command",
      "base": "cargo-build.plugin.json",
      "edits": [{ "op": "set", "path": "/buildSystems/0/tasks/0/arguments", "value": ["build", "${test.case}"] }],
      "expectedCode": "plugin.template.invalid"
    },
    {
      "name": "user arguments in a model command",
      "base": "go-build.plugin.json",
      "edits": [{ "op": "set", "path": "/buildSystems/0/model/arguments", "value": ["list", "-json", "${userArguments}"] }],
      "expectedCode": "plugin.template.invalid"
    },
    {
      "name": "output file without the file channel",
      "base": "gradle-build.plugin.json",
      "edits": [{ "op": "remove", "path": "/buildSystems/0/model/output" }],
      "expectedCode": "plugin.manifest.invalid"
    },
    {
