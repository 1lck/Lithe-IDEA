{
  "schemaVersion": 2,
  "id": "dev.lithe.fixture.node-runtime",
  "displayName": "Node Runtime Fixture",
  "version": "1.0.0",
  "pluginAPIVersion": 2,
  "vendor": {
    "id": "dev.lithe",
    "displayName": "Lithe",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": [
    "languageServer.launch"
  ],
  "activationEvents": [
    "onLanguage:fixture"
  ],
  "languages": [
    {
      "id": "fixture",
      "displayName": "Fixture",
      "fileExtensions": [
        "fixture"
      ]
    }
  ],
  "languageServers": [
    {
      "languageID": "fixture",
      "launch": {
        "kind": "runtime",
        "tool": "node",
        "minimumVersion": "18.17",
        "runtimeArguments": [
          "--max-old-space-size=2048",
          "--require=${pluginDir}/language-server/lib/preload.js"
        ],
        "entry": "language-server/lib/server.js"
      },
      "arguments": [
        "--stdio",
        "--storage",
        "${stateDir}/storage",
        "--workspace-cache",
        "${workspaceStateDir}"
      ],
      "initializationOptions": {
        "stubs": [
          "${pluginDir}/language-server/stubs/${arch}"
        ],
        "telemetry": false
      }
    }
  ]
}
