{
  "schemaVersion": 2,
  "id": "dev.lithe.fixture.debug-adapter-features",
  "displayName": "Debug Adapter Features Fixture",
  "version": "0.1.0",
  "pluginAPIVersion": 4,
  "requires": { "backend": 2, "debugAdapters": 3, "serverProcess": 1 },
  "vendor": {
    "id": "org.example",
    "displayName": "Example",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": [
    "backend.launch",
    "debug.launch",
    "debug.start"
  ],
  "activationEvents": [
    "onDebug:script",
    "onWorkspaceOpen"
  ],
  "languages": [],
  "backend": {
    "launch": { "kind": "packaged", "path": "bin/backend" },
    "arguments": ["--state", "${stateDir}"]
  },
  "debugAdapters": [
    {
      "id": "script",
      "displayName": "Script Debugger",
      "adapterID": "script-dap",
      "requests": ["launch"],
      "selectors": [{ "targetKinds": ["file"], "languageIDs": ["script"] }],
      "configurationTypes": ["script"],
      "configurations": {
        "launch": {
          "arguments": { "stopOnEntry": false },
          "targetBindings": { "program": "target.path", "cwd": "target.workingDirectory" }
        }
      },
      "features": {
        "hotCodeReplace": {
          "request": "script.reload",
          "event": "script.reloaded",
          "changedField": "modules",
          "errorField": "error"
        },
        "stepFilters": { "argument": "stepFilters" }
      },
      "defaults": {
        "stepFilters": {
          "classNameFilters": ["_vendor.*"],
          "skipSynthetics": true,
          "skipStaticInitializers": false,
          "skipConstructors": false,
          "hideFilteredStackFrames": false
        }
      },
      "launch": {
        "process": {
          "launch": { "kind": "packaged", "path": "bin/script-dap" },
          "arguments": ["--stdio"]
        },
        "transport": "stdio"
      }
    }
  ]
}
