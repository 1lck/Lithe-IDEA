{
  "schemaVersion": 2,
  "id": "dev.lithe.fixture.tool-reference-launch",
  "displayName": "Tool Reference Launch Fixture",
  "version": "0.1.0",
  "pluginAPIVersion": 4,
  "requires": {
    "backend": 2,
    "debugAdapters": 1,
    "executableResolution": 2,
    "languageServers": 1,
    "languages": 1,
    "outputLinkMatchers": 1,
    "serverProcess": 4,
    "toolDefinitions": 1
  },
  "requiresTools": ["interpreter"],
  "vendor": {
    "id": "org.example",
    "displayName": "Example",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": [
    "backend.launch",
    "debug.launch",
    "debug.start",
    "languageServer.launch",
    "run.start"
  ],
  "activationEvents": [
    "onDebug:script",
    "onLanguage:script",
    "onWorkspaceOpen"
  ],
  "languages": [
    {
      "id": "script",
      "displayName": "Script",
      "fileExtensions": ["script"]
    }
  ],
  "toolDefinitions": [
    {
      "id": "interpreter",
      "displayName": "Script interpreter",
      "icon": { "host": "plugin" },
      "executableLayouts": [
        { "path": "bin/interpreter", "platforms": ["macos", "linux"] },
        { "path": "bin/interpreter.exe", "platforms": ["windows"] }
      ],
      "executables": [
        { "id": "default", "kind": "setting", "settingID": "executable", "layer": "global" },
        { "id": "shell", "kind": "command", "command": "interpreter" }
      ],
      "version": {
        "arguments": ["--version"],
        "pattern": "Interpreter (\\d+(?:\\.\\d+)*)"
      },
      "homeLayouts": [{ "match": "*", "home": "." }],
      "commands": ["interpreter"],
      "launch": ["${executable}", "${runtimeArguments}", "${entry}", "${arguments}"]
    }
  ],
  "languageServers": [
    {
      "languageID": "script",
      "launch": {
        "kind": "runtime",
        "tool": "interpreter",
        "minimumVersion": "3.9",
        "runtimeArguments": ["-X", "utf8"],
        "entry": "language-server/server.script"
      },
      "arguments": ["--stdio"]
    }
  ],
  "backend": {
    "launch": { "kind": "packaged", "path": "bin/backend" },
    "arguments": ["--state", "${stateDir}"]
  },
  "debugAdapters": [
    {
      "id": "script",
      "displayName": "Script Debugger",
      "adapterID": "script-dap",
      "requests": ["launch"],
      "selectors": [{ "targetKinds": ["file"], "languageIDs": ["script"] }],
      "configurationTypes": ["script"],
      "launch": {
        "process": {
          "launch": { "kind": "packaged", "path": "bin/script-dap" },
          "arguments": ["--stdio"]
        },
        "transport": "stdio"
      }
    }
  ],
  "outputLinkMatchers": [
    {
      "id": "traceback",
      "pattern": "File \"(?P<path>[^\"]+)\", line (?P<line>\\d+)",
      "scope": "run"
    }
  ]
}
