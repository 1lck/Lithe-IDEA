{
  "schemaVersion": 2,
  "id": "dev.lithe.fixture.import",
  "displayName": "Shortcut import fixture",
  "version": "1.0.0",
  "pluginAPIVersion": 3,
  "requires": {"keymapImportProviders": 1, "backend": 2, "serverProcess": 1},
  "vendor": {"id": "org.example", "displayName": "Fixture publisher", "signatureRequirement": "publisherPackage"},
  "permissions": ["backend.launch", "keymaps.provide", "keymaps.readSelectedSources"],
  "keymapImportProviders": [
    {"id": "first", "displayName": "First editor", "recognition": [{"kind": "file", "path": "bindings.json"}, {"kind": "root", "base": "userConfig", "components": ["FirstEditor", "User"]}, {"kind": "root", "base": "userConfig", "components": ["FirstEditor", "User", "profiles", "*"]}], "inputs": [{"kind": "file", "path": "bindings.json"}]},
    {"id": "second", "displayName": "Second editor", "recognition": [{"kind": "directory", "path": "keymaps"}], "inputs": [
      {"kind": "file", "path": "options/map.xml"},
      {"kind": "directory", "path": "keymaps", "extension": "xml"}
    ]}
  ],
  "backend": {"launch": {"kind": "packaged", "path": "bin/import-provider"}, "arguments": ["--stdio"]}
}
