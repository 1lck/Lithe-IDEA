{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithe.dev/contracts/run-configuration-v2.schema.json",
  "title": "Lithe Run Configuration Document v2",
  "type": "object",
  "required": ["version", "configurations"],
  "properties": {
    "version": { "const": 2 },
    "generator": {
      "type": "object",
      "required": ["fingerprint"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^sha256:" },
        "providerFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "unreadablePaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "inputs": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "pattern": "^(sha256:.+|path)$" }
        }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "description": "Machine-local project toolchain defaults. Stored only in the local layer; non-empty per-configuration paths override matching defaults.",
      "properties": {
        "java": {
          "type": "object",
          "properties": {
            "homePath": { "type": "string" }
          },
          "additionalProperties": false
        },
        "maven": {
          "type": "object",
          "properties": {
            "executablePath": { "type": "string" },
            "javaHomePath": { "type": "string" }
          },
          "additionalProperties": false
        },
        "pathOverrides": {
          "type": "object",
          "description": "Machine-local subproject selections, keyed by normalized workspace-relative root. Empty fields inherit project defaults. Hosts preserve the map when saving individual run configurations.",
          "maxProperties": 256,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^\\\\:\\x00-\\x1f\\x7f]+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "javaHomePath": { "type": "string", "maxLength": 4096 },
              "mavenExecutablePath": { "type": "string", "maxLength": 4096 },
              "mavenJavaHomePath": { "type": "string", "maxLength": 4096 }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "configurations": {
      "type": "array",
      "items": { "$ref": "#/$defs/configuration" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).*$"
    },
    "buildProviderReference": {
      "type": "object",
      "required": [
        "pluginID",
        "buildSystemID",
        "root",
        "run",
        "projectID",
        "targetID"
      ],
      "properties": {
        "pluginID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "buildSystemID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "root": {
          "$ref": "#/$defs/relativePath"
        },
        "run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "projectID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "targetID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "userArguments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": ["id", "provider"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
        },
        "execution": { "enum": ["application", "service", "task", "group"] },
        "category": { "enum": ["project", "infrastructure"] },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "env": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string" }
        },
        "confidence": { "enum": ["native", "declared", "heuristic"] },
        "toolchains": { "type": "object", "additionalProperties": { "type": "string" } },
        "debug": {
          "type": "object",
          "required": ["adapter"],
          "properties": {
            "adapter": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "members": { "type": "array", "items": { "type": "string" } },
        "extensions": {
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "type": "object" }
        },
        "disabled": { "type": "boolean" },
        "source": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [{
        "if": { "properties": { "provider": { "const": "build.provider" } } },
        "then": {
          "required": ["extensions"],
          "properties": {
            "execution": { "const": "application" },
            "command": false,
            "args": { "maxItems": 0 },
            "env": { "maxProperties": 0 },
            "toolchains": { "maxProperties": 0 },
            "debug": false,
            "extensions": {
              "required": ["build"],
              "properties": { "build": { "$ref": "#/$defs/buildProviderReference" } }
            }
          }
        }
      }]
    }
  }
}
