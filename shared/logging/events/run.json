{
  "version": 1,
  "root": "run",
  "events": [
    {
      "id": "run.build.scratch_cleanup_failed",
      "channel": "run",
      "level": "warn",
      "message": "Build dependency {stage} cleanup failed",
      "fields": {
        "stage": {
          "type": "token",
          "required": true,
          "description": "Dependency-tree cleanup target, e.g. current-scratch or abandoned-scratch"
        },
        "error": {
          "type": "error",
          "required": true,
          "description": "Filesystem error raised while deleting a Maven dependency-tree scratch file"
        }
      },
      "rate": 60,
      "owner": "Lithe"
    },
    {
      "id": "run.configuration.operation_failed",
      "channel": "run",
      "level": "warn",
      "message": "Execution configuration operation failed",
      "fields": {
        "stage": {
          "type": "token",
          "required": true,
          "description": "Execution configuration phase that failed, load, plan, fingerprint or save"
        },
        "error": {
          "type": "error",
          "required": true,
          "description": "Underlying failure at this operation boundary, preserving stable domain and code"
        }
      },
      "rate": 60,
      "owner": "LitheExecutionModule"
    },
    {
      "id": "run.configuration.write_failed",
      "channel": "run",
      "level": "error",
      "message": "Execution configuration write failed",
      "fields": {
        "error": {
          "type": "error",
          "required": true,
          "description": "Underlying failure that prevented completing the requested operation"
        }
      },
      "rate": 60,
      "owner": "LitheExecutionModule"
    },
    {
      "id": "run.preparation.failed",
      "channel": "run",
      "level": "error",
      "message": "Execution preparation failed",
      "fields": {
        "error": {
          "type": "error",
          "required": true,
          "description": "Underlying failure that prevented completing the requested operation"
        }
      },
      "rate": 60,
      "owner": "LitheExecutionModule"
    },
    {
      "id": "run.process.execution",
      "channel": "run",
      "level": "info",
      "message": "Process {executable} execution",
      "fields": {
        "executable": {
          "type": "path",
          "required": true,
          "description": "Executable URL from the process request, redacted to a safe path before persistence"
        },
        "exit_code": {
          "type": "int",
          "required": false,
          "description": "Exit status of the child process; absent when it could not start"
        },
        "outcome": {
          "type": "token",
          "required": false,
          "description": "Process completion category, e.g. exited, timed-out or cancelled"
        }
      },
      "rate": 600,
      "owner": "Lithe",
      "span": {
        "failureLevel": "error"
      }
    },
    {
      "id": "run.process.io_failed",
      "channel": "run",
      "level": "warn",
      "message": "Process pipe {stage} failed",
      "fields": {
        "stage": {
          "type": "token",
          "required": true,
          "description": "Native pipe operation that failed: close, stdin-write, stdout-drain, stream-drain, or capture-drain"
        },
        "error": {
          "type": "error",
          "required": true,
          "description": "FileHandle error from releasing a process pipe or writing standard input"
        }
      },
      "rate": 60,
      "owner": "Lithe"
    }
  ]
}
