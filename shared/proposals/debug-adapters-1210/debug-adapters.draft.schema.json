{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithe.invalid/proposals/1210/debug-adapters.draft.schema.json",
  "title": "Proposed plugin.json debugAdapters capability block",
  "description": "Review-only projection of plugin.json.debugAdapters, not a second manifest. API 4, debugAdapters 1 and serverProcess 2 are proposed, not implemented. Full-manifest permissions, requires and semantic validation are specified in README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["debugAdapters"],
  "properties": {
    "debugAdapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "$defs": {
    "localID": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "packagePath": {
      "description": "Read-only package-relative path. Core must additionally reject escaping symlinks and platform-specific path escapes.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$))[^\\\\:\\u0000]+$"
    },
    "serverProcessV1": {
      "$ref": "../../contracts/plugins/v1/plugin-manifest.schema.json#/$defs/serverProcess",
      "description": "Reuse existing launch fields and validation. LSP initializationOptions have no meaning for a DAP transport and are excluded.",
      "propertyNames": { "enum": ["launch", "arguments", "validationArguments", "runtimeDependencies"] },
      "unevaluatedProperties": false
    },
    "runSelectedRuntimeProcess": {
      "description": "Proposed serverProcess 2 branch. Resolve through Run's selected runtime for this target, not a plugin dependency or a separate Debug runtime preference.",
      "type": "object",
      "additionalProperties": false,
      "required": ["launch"],
      "properties": {
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "tool"],
          "properties": {
            "kind": { "const": "runSelectedRuntime" },
            "tool": { "enum": ["python", "java", "node"] }
          }
        },
        "arguments": { "$ref": "../../contracts/plugins/v1/plugin-manifest.schema.json#/$defs/serverProcess/properties/arguments" },
        "validationArguments": { "$ref": "../../contracts/plugins/v1/plugin-manifest.schema.json#/$defs/serverProcess/properties/validationArguments" }
      }
    },
    "process": {
      "oneOf": [
        { "$ref": "#/$defs/serverProcessV1" },
        { "$ref": "#/$defs/runSelectedRuntimeProcess" }
      ]
    },
    "launch": {
      "type": "object",
      "required": ["process", "transport"],
      "properties": { "process": { "$ref": "#/$defs/process" } },
      "oneOf": [
        {
          "properties": { "transport": { "const": "stdio" } }
        },
        {
          "required": ["endpoint"],
          "properties": {
            "transport": { "const": "tcpAnnounced" },
            "endpoint": {
              "description": "A bounded line decoder, not an executable-name-specific format or a regex engine. Only loopback endpoints are accepted.",
              "type": "object",
              "additionalProperties": false,
              "required": ["stream", "prefix", "value"],
              "properties": {
                "stream": { "enum": ["stdout", "stderr"] },
                "prefix": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" },
                "value": { "enum": ["port", "hostPort"] }
              }
            }
          }
        },
        {
          "required": ["endpoint"],
          "properties": {
            "transport": { "const": "tcpPort" },
            "endpoint": {
              "description": "A fixed loopback port for this adapter process, not the debuggee's attach port. Conflicts fail explicitly; no automatic port substitution.",
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "selector": {
      "description": "Optional automatic matching: OR between selectors, AND between fields. Omission means explicit selection only, not a wildcard registration.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "targetKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["file", "executable", "runTarget", "process", "connection"] }
        },
        "languageIDs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9+_-]+$" }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "arguments": {
          "description": "Adapter-owned default DAP arguments. Ordinary JSON data; no embedded references, expressions or resource handles are interpreted.",
          "type": "object"
        },
        "parametersSchema": {
          "description": "Optional packaged schema for final merged DAP arguments, with local read-only refs only. Not a new Debug configuration file.",
          "$ref": "#/$defs/packagePath"
        },
        "targetBindings": {
          "description": "Typed projections into known DAP fields. They only fill missing arguments; explicit values retain their existing precedence.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "program": { "const": "target.path" },
            "processId": { "const": "target.processID" },
            "cwd": { "const": "target.workingDirectory" }
          }
        }
      }
    },
    "capabilities": {
      "description": "Optional suppression only. Disabled entries are standard DAP initialize capability names plus exceptionBreakpointFilters. Omission follows DAP; true values and function implementations are not accepted.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "disabled": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(supports[A-Z][A-Za-z0-9]*|exceptionBreakpointFilters)$"
          }
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "launch"],
      "properties": {
        "id": { "$ref": "#/$defs/localID" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapterID": {
          "description": "DAP initialize adapterID. Defaults to the local adapter id; never substitutes for the qualified Registry identity.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requests": {
          "description": "Defaults to launch only. Attach must be explicitly declared and separately authorized.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["launch", "attach"] },
          "default": ["launch"]
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selector" }
        },
        "configurationTypes": {
          "description": "Optional imported launch.json type aliases. Ambiguity requires selection; aliases do not override another provider.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "configurations": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "launch": { "$ref": "#/$defs/configuration" },
            "attach": { "$ref": "#/$defs/configuration" }
          }
        },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "launch": { "$ref": "#/$defs/launch" }
      }
    }
  }
}
