{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithe.invalid/proposals/1210/debug-composition.draft.schema.json",
  "title": "Plugin dependency and JSON composition review draft",
  "description": "Proposed reusable composition layer, not a change to existing private plugin-function protocol versions. All schema paths belong to their exporting package.",
  "$ref": "#/$defs/workflow",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9._-]*$" },
    "schemaPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$))[^\\\\:\\u0000]+$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginID", "minimumVersion"],
      "properties": {
        "pluginID": { "$ref": "#/$defs/id" },
        "minimumVersion": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
        "maximumVersionExclusive": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" }
      }
    },
    "import": {
      "description": "Only a declared direct dependency's explicitly exported contract can be used. The dependency may compose its own dependencies internally.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "export", "contractVersion"],
      "properties": {
        "dependency": { "$ref": "#/$defs/id" },
        "export": { "$ref": "#/$defs/id" },
        "contractVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "use": {
      "oneOf": [
        { "$ref": "#/$defs/import" },
        {
          "description": "A function on this package's backend, invoked through lithe/function/invoke. An export's domain contract validates its inputs and result.",
          "type": "object",
          "additionalProperties": false,
          "required": ["backendRef", "functionID"],
          "properties": {
            "backendRef": { "$ref": "#/$defs/id" },
            "functionID": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[a-z][a-zA-Z0-9]*(?:[.][a-z][a-zA-Z0-9]*)*$"
            }
          }
        },
        {
          "description": "A versioned host service used by a JSON workflow. The host, rather than a blocked backend handler, drives the workflow.",
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "version"],
          "properties": {
            "host": { "$ref": "#/$defs/id" },
            "version": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "value": {
      "description": "JSON values with typed whole-value bindings. $value is a JSON Pointer into input/context/completed steps, not an expression or string interpolation. $literal escapes reserved objects.",
      "oneOf": [
        { "type": ["null", "boolean", "number", "string"] },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$value"],
          "properties": {
            "$value": {
              "type": "string",
              "pattern": "^/(?:input|context|steps)(?:/(?:[^~/]|~[01])*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$literal"],
          "properties": { "$literal": true }
        },
        {
          "type": "object",
          "propertyNames": { "not": { "enum": ["$value", "$literal"] } },
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      ]
    },
    "arguments": {
      "type": "object",
      "propertyNames": { "not": { "enum": ["$value", "$literal"] } },
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use"],
      "properties": {
        "use": { "$ref": "#/$defs/use" },
        "with": { "$ref": "#/$defs/arguments" }
      }
    },
    "workflow": {
      "oneOf": [
        { "$ref": "#/$defs/call" },
        {
          "description": "Bounded, sequential composition. A step may read only input/context and earlier results. A failure stops the flow and triggers owned-resource cleanup.",
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "result"],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "use"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "use": { "$ref": "#/$defs/use" },
                  "with": { "$ref": "#/$defs/arguments" }
                }
              }
            },
            "result": { "$ref": "#/$defs/value" }
          }
        }
      ]
    },
    "export": {
      "description": "Public, typed dependency surface. This does not publish a plugin's private runtime function registry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "implementation"],
      "properties": {
        "contract": {
          "description": "Known contracts resolve through Core's versioned catalog. Custom IDs must supply both packaged schemas; changing either schema incompatibly requires a contract version change.",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "version": { "type": "integer", "minimum": 1 },
            "inputSchema": { "$ref": "#/$defs/schemaPath" },
            "resultSchema": { "$ref": "#/$defs/schemaPath" }
          },
          "dependentRequired": {
            "inputSchema": ["resultSchema"],
            "resultSchema": ["inputSchema"]
          }
        },
        "implementation": { "$ref": "#/$defs/workflow" }
      }
    }
  }
}
