{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithe.invalid/proposals/1210/debug-capability-state.draft.schema.json",
  "title": "Effective debug capabilities review draft",
  "description": "A host-computed snapshot, never a plugin assertion. It combines manifest policy, negotiated DAP/backend capabilities, host implementation and granted permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draftVersion", "sessionID", "revision", "capabilities"],
  "properties": {
    "draftVersion": { "const": "1210-3" },
    "sessionID": { "type": "string", "minLength": 1 },
    "revision": {
      "description": "Monotonically increasing within a session. Stale snapshots and snapshots from a replaced session are ignored.",
      "type": "integer",
      "minimum": 1
    },
    "capabilities": {
      "description": "Session snapshot. Omitted capability IDs are not exposed; they are never assumed supported. Each revision replaces the previous map.",
      "type": "object",
      "propertyNames": {
        "$ref": "debug-adapter-registration.draft.schema.json#/$defs/capabilityID"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "source"],
        "properties": {
          "state": { "enum": ["unknown", "supported", "unsupported"] },
          "source": { "enum": ["dap", "backend", "manifest", "host", "permission", "target"] },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pluginID", "export"],
            "properties": {
              "pluginID": { "$ref": "debug-adapter-registration.draft.schema.json#/$defs/id" },
              "export": { "$ref": "debug-composition.draft.schema.json#/$defs/id" }
            }
          },
          "reason": {
            "enum": [
              "not_negotiated", "adapter_unsupported", "backend_unsupported", "not_exposed",
              "host_not_supported", "permission_denied", "not_applicable"
            ]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "source": { "const": "backend" } } },
            "then": { "required": ["provider"] },
            "else": { "not": { "required": ["provider"] } }
          },
          {
            "if": { "properties": { "state": { "const": "supported" } } },
            "then": {
              "not": { "required": ["reason"] },
              "properties": { "source": { "enum": ["dap", "backend"] } }
            },
            "else": { "required": ["reason"] }
          },
          {
            "if": { "properties": { "state": { "const": "unknown" } } },
            "then": {
              "properties": {
                "source": { "enum": ["dap", "backend"] },
                "reason": { "const": "not_negotiated" }
              }
            }
          }
        ]
      }
    }
  }
}
