{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithe.invalid/proposals/1210/debug-configuration.draft.schema.json",
  "title": "Debug configuration review draft",
  "description": "Normalized input after existing Run configuration resolution. This is not a replacement workspace file format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draftVersion", "id", "name", "request", "target", "parameters"],
  "properties": {
    "draftVersion": { "const": "1210-3" },
    "id": { "$ref": "#/$defs/reference" },
    "name": { "type": "string", "minLength": 1 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginID", "id"],
      "properties": {
        "pluginID": { "$ref": "#/$defs/reference" },
        "id": { "$ref": "#/$defs/reference" }
      }
    },
    "request": { "enum": ["launch", "attach"] },
    "target": { "$ref": "#/$defs/target" },
    "parameters": {
      "description": "Validated against the selected Provider's packaged request schema. Unknown upstream fields are preserved by import, not silently discarded.",
      "type": "object"
    },
    "steppingFilters": { "$ref": "#/$defs/steppingFilters" }
  },
  "$defs": {
    "reference": { "type": "string", "minLength": 1 },
    "workspacePath": {
      "description": "Workspace-relative identity. Native conversion, symlink checks and external-resource authorization belong to the host.",
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$))[^\\\\:\\u0000]+$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "enum": ["file", "executable"] },
            "path": { "$ref": "#/$defs/workspacePath" },
            "languageID": { "$ref": "#/$defs/reference" }
          }
        },
        {
          "description": "Existing Run identity, including upstream-owned build products and project targets.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "configurationID"],
          "properties": {
            "kind": { "const": "runTarget" },
            "configurationID": { "$ref": "#/$defs/reference" },
            "languageID": { "$ref": "#/$defs/reference" }
          }
        },
        {
          "description": "Host-issued process reference, valid only in the captured workspace/operation. Never persisted or inferred from a process name.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "processRef"],
          "properties": {
            "kind": { "const": "process" },
            "processRef": { "$ref": "#/$defs/reference" },
            "languageID": { "$ref": "#/$defs/reference" }
          }
        },
        {
          "description": "Host-authorized debuggee connection, distinct from the DAP adapter transport. Transient; contains no credentials.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "connectionRef"],
          "properties": {
            "kind": { "const": "connection" },
            "connectionRef": { "$ref": "#/$defs/reference" },
            "languageID": { "$ref": "#/$defs/reference" }
          }
        }
      ]
    },
    "steppingFilters": {
      "description": "Existing DebugSteppingFilters fields and omission semantics are retained.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classNameFilters": { "type": "array", "items": { "type": "string" } },
        "skipSynthetics": { "type": "boolean" },
        "skipStaticInitializers": { "type": "boolean" },
        "skipConstructors": { "type": "boolean" },
        "hideFilteredStackFrames": { "type": "boolean" }
      }
    }
  }
}
