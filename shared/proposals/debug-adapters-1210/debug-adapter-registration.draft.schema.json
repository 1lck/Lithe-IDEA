{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithe.invalid/proposals/1210/debug-adapter-registration.draft.schema.json",
  "title": "Debug adapter registration review draft",
  "description": "Issue 1210 review artifact. Not an installable plugin manifest or an allocated plugin API version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draftVersion", "pluginID"],
  "anyOf": [
    { "required": ["debugAdapters"] },
    { "required": ["exports"] }
  ],
  "properties": {
    "draftVersion": { "const": "1210-3" },
    "pluginID": { "$ref": "#/$defs/id" },
    "pluginDependencies": {
      "description": "Plugin package dependencies, distinct from requires (host API capabilities) and upstream project dependencies.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "debug-composition.draft.schema.json#/$defs/dependency" }
    },
    "exports": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "debug-composition.draft.schema.json#/$defs/id" },
      "additionalProperties": { "$ref": "debug-composition.draft.schema.json#/$defs/export" }
    },
    "backends": {
      "description": "Same-plugin DAP or plugin-function resources. Dependencies reuse their own resources; importers never copy their paths or private handles.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/backend" }
    },
    "debugAdapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "packagePath": {
      "description": "Read-only package-relative path. The host also rejects escaping symlinks and invalid platform paths.",
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$))[^\\\\:\\u0000]+$"
    },
    "serverProcess": {
      "description": "Reuse serverProcess:1 launch semantics without its LSP initializationOptions field.",
      "$ref": "../../contracts/plugins/v1/plugin-manifest.schema.json#/$defs/serverProcess",
      "propertyNames": {
        "enum": ["launch", "arguments", "validationArguments", "runtimeDependencies"]
      },
      "unevaluatedProperties": false
    },
    "debugProcess": {
      "oneOf": [
        { "$ref": "#/$defs/serverProcess" },
        {
          "description": "Reuse a runtime exported by a declared plugin dependency, without copying that plugin's executable paths or discovery rules.",
          "type": "object",
          "additionalProperties": false,
          "required": ["launch", "arguments"],
          "properties": {
            "launch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "use"],
              "properties": {
                "kind": { "const": "dependencyRuntime" },
                "use": { "$ref": "debug-composition.draft.schema.json#/$defs/import" }
              }
            },
            "arguments": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "stdioTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "processRef"],
      "properties": {
        "kind": { "const": "stdio" },
        "processRef": {
          "description": "Host-issued process lease, scoped to the declaring package and current operation. Safe to pass through composed dependency calls.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selector": {
      "description": "Selectors are ORed. Fields within a selector are ANDed. No priority or executable discovery runs during matching.",
      "type": "object",
      "additionalProperties": false,
      "required": ["targetKinds"],
      "properties": {
        "targetKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["file", "executable", "runTarget", "process", "connection"] }
        },
        "languageIDs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parametersSchema"],
      "properties": {
        "parametersSchema": {
          "description": "Packaged Draft 2020-12 schema for parameters. Local package refs only; no network fetching.",
          "$ref": "#/$defs/packagePath"
        },
        "targetBindings": {
          "description": "DAP argument name to a typed, host-resolved target value. Applied by the host after resolution for every backend kind. Conflicting arguments are rejected, never overwritten.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": {
            "enum": ["target.path", "target.processID", "target.host", "target.port"]
          }
        }
      }
    },
    "backend": {
      "oneOf": [
        {
          "description": "Reuse a same-plugin language server owned by that plugin and negotiating litheFunctions. A host-owned shared server must instead stay behind its typed host-integration adapter.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "languageID"],
          "properties": {
            "kind": { "const": "languageServer" },
            "languageID": { "$ref": "#/$defs/id" }
          }
        },
        {
          "description": "Reuse an existing typed host integration, such as JDT. The same-plugin language server must declare that integration.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "languageID", "integrationID"],
          "properties": {
            "kind": { "const": "hostIntegration" },
            "languageID": { "$ref": "#/$defs/id" },
            "integrationID": { "$ref": "#/$defs/id" }
          }
        },
        {
          "description": "DAP or the existing plugin-function process protocol. No separate Debug RPC protocol or UI backend is required.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "protocol", "process", "lifetime"],
          "properties": {
            "kind": { "const": "process" },
            "protocol": { "enum": ["dap", "pluginFunctions"] },
            "process": { "$ref": "#/$defs/debugProcess" },
            "lifetime": { "enum": ["session", "workspace"] }
          },
          "if": { "properties": { "protocol": { "const": "dap" } } },
          "then": {
            "properties": { "lifetime": { "const": "session" } }
          }
        }
      ]
    },
    "capabilityID": {
      "enum": [
        "sourceBreakpoints", "conditionalBreakpoints", "hitConditionalBreakpoints", "logPoints",
        "functionBreakpoints", "dataBreakpoints", "exceptionInfo", "setVariable", "restart",
        "terminate", "stepBack", "stepInTargets", "gotoTargets", "readMemory", "writeMemory",
        "disassemble", "instructionBreakpoints", "instructionStepping", "hotCodeReplace"
      ]
    },
    "dapCapability": {
      "description": "A standard operation can use DAP or a typed function binding. Host and permission checks apply to both.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": { "source": { "enum": ["dap", "disabled"] } }
        },
        { "$ref": "#/$defs/functionCapability" }
      ]
    },
    "functionCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "invoke"],
      "properties": {
        "source": { "const": "function" },
        "invoke": { "$ref": "debug-composition.draft.schema.json#/$defs/workflow" }
      }
    },
    "capabilities": {
      "description": "Manifest policy. Omitted features are not exposed through this registration. Basic threads, stack, scopes, variables and execution remain the common DAP session contract.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceBreakpoints": { "$ref": "#/$defs/dapCapability" },
        "conditionalBreakpoints": { "$ref": "#/$defs/dapCapability" },
        "hitConditionalBreakpoints": { "$ref": "#/$defs/dapCapability" },
        "logPoints": { "$ref": "#/$defs/dapCapability" },
        "functionBreakpoints": { "$ref": "#/$defs/dapCapability" },
        "dataBreakpoints": { "$ref": "#/$defs/dapCapability" },
        "exceptionInfo": { "$ref": "#/$defs/dapCapability" },
        "setVariable": { "$ref": "#/$defs/dapCapability" },
        "restart": { "$ref": "#/$defs/dapCapability" },
        "terminate": { "$ref": "#/$defs/dapCapability" },
        "stepBack": { "$ref": "#/$defs/dapCapability" },
        "stepInTargets": { "$ref": "#/$defs/dapCapability" },
        "gotoTargets": { "$ref": "#/$defs/dapCapability" },
        "readMemory": { "$ref": "#/$defs/dapCapability" },
        "writeMemory": { "$ref": "#/$defs/dapCapability" },
        "disassemble": { "$ref": "#/$defs/dapCapability" },
        "instructionBreakpoints": { "$ref": "#/$defs/dapCapability" },
        "instructionStepping": { "$ref": "#/$defs/dapCapability" },
        "hotCodeReplace": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source"],
              "properties": { "source": { "const": "disabled" } }
            },
            { "$ref": "#/$defs/functionCapability" }
          ]
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "adapterID", "selectors", "requests", "capabilities", "session"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 },
        "adapterID": {
          "description": "DAP initialize.adapterID. Not a language ID, executable name, or global Provider identity.",
          "type": "string",
          "minLength": 1
        },
        "configurationTypes": {
          "description": "Import aliases, for example launch.json type. Overlap requires ordinary Provider selection, not replacement.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selector" }
        },
        "platforms": {
          "description": "Adapter host constraints, not debuggee architecture or runtime DAP capabilities.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "architectures"],
            "properties": {
              "os": { "enum": ["macos", "windows"] },
              "architectures": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["arm64", "x86_64"] }
              }
            }
          }
        },
        "requests": {
          "description": "Presence declares an available configuration shape, not the capabilities of a live DAP session.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "launch": { "$ref": "#/$defs/request" },
            "attach": { "$ref": "#/$defs/request" }
          }
        },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "session": { "$ref": "debug-composition.draft.schema.json#/$defs/workflow" }
      }
    }
  }
}
