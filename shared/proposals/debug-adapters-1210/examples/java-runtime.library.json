{
  "draftVersion": "1210-3",
  "pluginID": "example.java-runtime",
  "pluginDependencies": {
    "project": {
      "pluginID": "example.java-project-runtime",
      "minimumVersion": "1.0.0",
      "maximumVersionExclusive": "2.0.0"
    }
  },
  "backends": {
    "jdt": { "kind": "hostIntegration", "languageID": "java", "integrationID": "jdt" }
  },
  "exports": {
    "debugSession": {
      "contract": { "id": "debug.session.resolve", "version": 1 },
      "implementation": {
        "steps": [
          {
            "id": "target",
            "use": { "dependency": "project", "export": "prepareDebugTarget", "contractVersion": 1 },
            "with": { "configuration": { "$value": "/input/configuration" } }
          },
          {
            "id": "session",
            "use": { "backendRef": "jdt", "functionID": "debug.resolve" },
            "with": {
              "contextToken": { "$value": "/context/contextToken" },
              "configuration": { "$value": "/input/configuration" },
              "target": { "$value": "/steps/target" }
            }
          }
        ],
        "result": { "$value": "/steps/session" }
      }
    },
    "hotCodeReplace": {
      "contract": { "id": "debug.hot-code-replace", "version": 1 },
      "implementation": {
        "use": { "backendRef": "jdt", "functionID": "debug.hotCodeReplace" },
        "with": {
          "contextToken": { "$value": "/context/contextToken" },
          "sessionID": { "$value": "/input/sessionID" }
        }
      }
    }
  }
}
