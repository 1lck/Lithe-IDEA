{
  "draftVersion": "1210-3",
  "pluginID": "example.js-debug",
  "pluginDependencies": {
    "node": {
      "pluginID": "example.node-runtime",
      "minimumVersion": "1.0.0",
      "maximumVersionExclusive": "2.0.0"
    },
    "dap": {
      "pluginID": "example.dap-runtime",
      "minimumVersion": "1.0.0",
      "maximumVersionExclusive": "2.0.0"
    }
  },
  "backends": {
    "adapter": {
      "kind": "process",
      "protocol": "dap",
      "lifetime": "session",
      "process": {
        "launch": {
          "kind": "dependencyRuntime",
          "use": {
            "dependency": "node",
            "export": "selectedRuntime",
            "contractVersion": 1
          }
        },
        "arguments": ["${pluginDir}/adapter/dapDebugServer.js"]
      }
    }
  },
  "debugAdapters": [
    {
      "id": "js-debug",
      "displayName": "JavaScript / TypeScript",
      "adapterID": "pwa-node",
      "configurationTypes": [
        "pwa-node",
        "node"
      ],
      "selectors": [
        {
          "targetKinds": [
            "file",
            "runTarget"
          ],
          "languageIDs": [
            "javascript",
            "typescript"
          ]
        }
      ],
      "requests": {
        "launch": {
          "parametersSchema": "schemas/node-launch.schema.json"
        }
      },
      "capabilities": {
        "sourceBreakpoints": {
          "source": "dap"
        },
        "conditionalBreakpoints": {
          "source": "dap"
        },
        "logPoints": {
          "source": "dap"
        },
        "exceptionInfo": {
          "source": "dap"
        },
        "restart": {
          "source": "dap"
        }
      },
      "session": {
        "use": {
          "dependency": "dap",
          "export": "announcedTcpSession",
          "contractVersion": 1
        },
        "with": {
          "adapter": {
            "backendRef": "adapter"
          },
          "configuration": {
            "$value": "/input/configuration"
          },
          "endpointFormat": "jsDebugStandalone"
        }
      }
    }
  ]
}
