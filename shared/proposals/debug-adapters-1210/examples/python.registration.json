{
  "draftVersion": "1210-3",
  "pluginID": "example.python-debug",
  "pluginDependencies": {
    "python": {
      "pluginID": "example.python-runtime",
      "minimumVersion": "1.0.0",
      "maximumVersionExclusive": "2.0.0"
    },
    "dap": {
      "pluginID": "example.dap-runtime",
      "minimumVersion": "1.0.0",
      "maximumVersionExclusive": "2.0.0"
    }
  },
  "backends": {
    "adapter": {
      "kind": "process",
      "protocol": "dap",
      "lifetime": "session",
      "process": {
        "launch": {
          "kind": "dependencyRuntime",
          "use": {
            "dependency": "python",
            "export": "selectedInterpreter",
            "contractVersion": 1
          }
        },
        "arguments": [
          "-m",
          "debugpy.adapter"
        ]
      }
    }
  },
  "debugAdapters": [
    {
      "id": "debugpy",
      "displayName": "Python (debugpy)",
      "adapterID": "debugpy",
      "configurationTypes": [
        "debugpy",
        "python"
      ],
      "selectors": [
        {
          "targetKinds": [
            "file",
            "runTarget"
          ],
          "languageIDs": [
            "python"
          ]
        }
      ],
      "requests": {
        "launch": {
          "parametersSchema": "schemas/python-launch.schema.json",
          "targetBindings": {
            "program": "target.path"
          }
        }
      },
      "capabilities": {
        "sourceBreakpoints": {
          "source": "dap"
        },
        "conditionalBreakpoints": {
          "source": "dap"
        },
        "hitConditionalBreakpoints": {
          "source": "dap"
        },
        "logPoints": {
          "source": "dap"
        },
        "exceptionInfo": {
          "source": "dap"
        },
        "setVariable": {
          "source": "dap"
        },
        "restart": {
          "source": "dap"
        }
      },
      "session": {
        "use": {
          "dependency": "dap",
          "export": "stdioSession",
          "contractVersion": 1
        },
        "with": {
          "adapter": {
            "backendRef": "adapter"
          },
          "configuration": {
            "$value": "/input/configuration"
          }
        }
      }
    }
  ]
}
