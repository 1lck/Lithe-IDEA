# Shared i18n generation compares exact bytes on every host, including Windows
# checkouts with core.autocrlf=true. Keep generated resources deterministic.
macos/Resources/*.lproj/Localizable.strings text eol=lf
macos/Sources/Lithe/Models/Settings/AppLanguage.generated.swift text eol=lf
windows/tauri/src/i18n/shared.generated.ts text eol=lf

# Project generator templates are emitted byte-for-byte; never convert their line endings.
Plugins/mac/Official/JavaSupport/templates/** -text

# Structured logging generated sources must compare byte-for-byte on Windows.
macos/Sources/LitheModuleAPI/Logging/*.swift text eol=lf
rust/lithe-core/src/diagnostics/catalog_generated.rs text eol=lf
# Pinned upstream JavaScript is checked by its release SHA-256 on every host.
macos/Sources/Lithe/Resources/MarkdownPreview/vendor/plantuml/plantuml.js -text
