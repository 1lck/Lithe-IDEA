# Shared i18n generation compares exact bytes on every host, including Windows checkouts
# with core.autocrlf=true, so the generated Go localization stays LF.
desktop/internal/i18n/shared.generated.go text eol=lf

# gofmt compares the bytes it prints with the file, so a Windows checkout that converted Go
# sources to CRLF would report every file as unformatted. Keep them LF like the other hosts.
desktop/**/*.go text eol=lf
desktop/go.mod text eol=lf
desktop/go.sum text eol=lf
# desktop/version_test.go reads this file line by line with a `$`-anchored expression, which a
# CRLF checkout would never match.
desktop/viva.toml text eol=lf

# The bundled fonts and their licenses are compiled in byte-for-byte and checked against the
# SHA-256 manifest in NOTICE.txt; never convert their line endings.
desktop/internal/bundledfont/fonts/** -text

# The Windows ConPTY binaries and their license are compiled in byte-for-byte and checked
# against the SHA-256 table in NOTICE.md.
desktop/internal/localshell/conpty/**/*.dll binary
desktop/internal/localshell/conpty/**/*.exe binary
desktop/internal/localshell/conpty/LICENSE.txt -text
desktop/internal/localshell/conpty/NOTICE.md -text
