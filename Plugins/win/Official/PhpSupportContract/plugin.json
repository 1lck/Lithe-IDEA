{
  "schemaVersion": 2,
  "id": "dev.lithe.plugin.php-support",
  "displayName": "PHP Support (contract)",
  "version": "1.0.0",
  "pluginAPIVersion": 2,
  "vendor": {
    "id": "dev.lithe",
    "displayName": "Lithe",
    "signatureRequirement": "sameTeamAsHost"
  },
  "permissions": [
    "languageServer.launch",
    "process.run",
    "process.test"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onRun:php",
    "onTest:php"
  ],
  "languages": [
    {
      "id": "php",
      "displayName": "PHP",
      "fileExtensions": [
        "php",
        "phtml"
      ],
      "projectFileNames": [
        "composer.json"
      ]
    }
  ],
  "languageServers": [
    {
      "languageID": "php",
      "languageIdentifier": "php",
      "launch": {
        "kind": "runtime",
        "tool": "node",
        "entry": "language-server/bin/intelephense.js"
      },
      "arguments": [
        "--stdio"
      ]
    }
  ],
  "executionProviders": [
    {
      "languageID": "php",
      "run": {
        "executable": {
          "command": "php"
        },
        "arguments": [
          "${file}",
          "${userArguments}"
        ]
      },
      "test": {
        "frameworkID": "phpunit",
        "workspaceLabel": "All PHP Tests",
        "projectMarkers": [
          "composer.json",
          "phpunit.xml",
          "phpunit.xml.dist"
        ],
        "testFilePatterns": [
          "*test.php"
        ],
        "executable": {
          "command": "php"
        },
        "workspaceArguments": [
          "vendor/bin/phpunit"
        ],
        "fileArguments": [
          "vendor/bin/phpunit",
          "${file}"
        ],
        "testCaseArguments": [
          "vendor/bin/phpunit",
          "--filter",
          "\b${testName:regex}\b",
          {
            "value": "${file}",
            "when": "fileSelected"
          }
        ]
      }
    }
  ]
}
