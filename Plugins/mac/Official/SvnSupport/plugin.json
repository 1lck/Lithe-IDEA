{
  "schemaVersion": 2,
  "id": "dev.lithe.plugin.svn-support",
  "displayName": "Subversion Support",
  "version": "0.1.0",
  "pluginAPIVersion": 3,
  "requires": {"serverProcess": 1, "vcsProviders": 1},
  "vendor": {
    "id": "dev.lithe",
    "displayName": "Lithe",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": ["languageServer.launch", "process.vcs"],
  "activationEvents": ["onVcsRoot:svn"],
  "languages": [],
  "vcsProviders": [
    {
      "id": "svn",
      "displayName": "Subversion",
      "detection": {
        "markers": [{"name": ".svn", "type": "directory"}]
      },
      "metadataPaths": [".svn/wc.db"],
      "tool": {
        "commands": ["svn"],
        "validationArguments": ["--version", "--quiet"]
      },
      "launch": {
        "kind": "runtime",
        "tool": "node",
        "minimumVersion": "20.3",
        "entry": "provider/svn-provider.mjs"
      },
      "arguments": ["--stdio"],
      "mayUseNetwork": true
    }
  ]
}
