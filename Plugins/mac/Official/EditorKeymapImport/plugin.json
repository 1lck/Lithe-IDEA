{
  "schemaVersion": 2,
  "id": "dev.lithe.plugin.editor-keymap-import",
  "displayName": "Editor Shortcut Import",
  "version": "1.0.0",
  "pluginAPIVersion": 3,
  "requires": {"backend": 2, "serverProcess": 1, "packageTrust": 1, "keymapImportProviders": 1},
  "vendor": {
    "id": "dev.lithe",
    "displayName": "Lithe",
    "signatureRequirement": "publisherPackage",
    "bundledSignatureRequirement": "sameTeamAsHost"
  },
  "permissions": ["backend.launch", "keymaps.provide", "keymaps.readSelectedSources"],
  "keymapImportProviders": [
    {
      "id": "vscode",
      "displayName": "Visual Studio Code",
      "recognition": [
        {"kind": "file", "path": "settings.json"}, {"kind": "file", "path": "keybindings.json"},
        {"kind": "root", "base": "userConfig", "components": ["Code", "User"]},
        {"kind": "root", "base": "userConfig", "components": ["Code", "User", "profiles", "*"]},
        {"kind": "root", "base": "userConfig", "components": ["Code - Insiders", "User"]},
        {"kind": "root", "base": "userConfig", "components": ["Code - Insiders", "User", "profiles", "*"]},
        {"kind": "root", "base": "userConfig", "components": ["Cursor", "User"]},
        {"kind": "root", "base": "userConfig", "components": ["Cursor", "User", "profiles", "*"]}
      ],
      "inputs": [{"kind": "file", "path": "keybindings.json"}]
    },
    {
      "id": "idea",
      "displayName": "IntelliJ IDEA",
      "recognition": [{"kind": "directory", "path": "options"}],
      "inputs": [{"kind": "file", "path": "options/keymap.xml"}, {"kind": "directory", "path": "keymaps", "extension": "xml"}]
    }
  ],
  "backend": {"launch": {"kind": "packaged", "path": "bin/editor-keymap-import"}, "arguments": []}
}
