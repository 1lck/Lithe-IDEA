# Top-level directories of the in-repository Rust kernel and the SwiftUI and Tauri clients,
# which this tree no longer has. Checkouts that switch here from an older branch keep their
# ignored build state (cargo targets, SwiftPM and node_modules directories) on disk; these
# entries keep it out of git status. Shared contracts, fixtures and i18n remain tracked.
/rust/
/macos/
/windows/
/frontend/
/Plugins/
/third_party/
/shared/*
!/shared/i18n/
!/shared/contracts/
!/shared/fixtures/
!/shared/platform-feature-matrix/
/node_modules/
/.build/
/.swiftpm/
DerivedData/

# Generated by scripts/desktop/package-desktop.sh for the lithe_bundled_helper build tag.
desktop/internal/idehelp/lithe-mcp.bin
